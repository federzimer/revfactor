<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.revfactor.brain-scan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aaronwhittaker/Claude/RevFactor/scripts/brain_scan_wrapper.sh</string>
    </array>

    <!-- Run daily at 9:00 AM local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Mac Studio is always on; run once at load so a fresh install
         does not wait until the next 9 AM to prove itself. -->
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/aaronwhittaker/Claude/RevFactor</string>

    <key>StandardOutPath</key>
    <string>/Users/aaronwhittaker/Claude/RevFactor/scripts/logs/brain-scan.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/aaronwhittaker/Claude/RevFactor/scripts/logs/brain-scan.err.log</string>
</dict>
</plist>
