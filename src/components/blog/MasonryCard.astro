---
// Image-overlay or cedar/moss text card used inside the journal masonry grid.
// Kept in its own file so the index can iterate the same template across 3
// column wrappers without duplicating markup.
type Props = {
  href: string;
  cat: string;
  variant: 'overlay' | 'text' | 'cedar' | 'moss';
  ar?: string;
  img?: string;
  imgSrcset?: string;
  imgSizes?: string;
  imgAlt?: string;
  date: string;
  read: string;
  title: string;
  excerpt?: string;
  quote?: string;
};
const p = Astro.props as Props;
const isText = p.variant === 'cedar' || p.variant === 'moss';
const bg = p.variant === 'cedar' ? '#13342D' : '#5D6D59';
const hoverBg = p.variant === 'cedar' ? '#1E4A40' : '#7A8B76';
const accent = p.variant === 'cedar' ? '#A9BBA3' : '#DDDAD3';
---

{isText ? (
  <a
    href={p.href}
    data-cat={p.cat}
    class={`post-card block rounded-[16px] overflow-hidden text-[#E8E6E1] p-8 hover:-translate-y-1 transition-all duration-[350ms] group`}
    style={`background-color:${bg};`}
    onmouseover={`this.style.backgroundColor='${hoverBg}'`}
    onmouseout={`this.style.backgroundColor='${bg}'`}
  >
    <span class="font-bold uppercase text-[9px] tracking-[2.5px] mb-4 inline-block" style={`color:${accent};`}>{p.cat} · field note</span>
    <h3 class="leading-[1.05] mb-4 text-[#E8E6E1]" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:30px; text-wrap:balance;">{p.title}</h3>
    {p.quote && (
      <blockquote class="text-[15px] leading-[1.45] mb-5 text-[#E8E6E1]/95" style="font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-weight:300;">
        "{p.quote}"
      </blockquote>
    )}
    {p.excerpt && !p.quote && (
      <p class="text-[14px] leading-[1.6] text-[#DDDAD3]/85 mb-5">{p.excerpt}</p>
    )}
    <div class="flex items-center justify-between text-[10.5px] tracking-[0.5px] uppercase text-[#DDDAD3]/70" style="font-family:'JetBrains Mono',monospace;">
      <span>{p.date}{p.read && ` · ${p.read}`}</span>
      <span class="inline-flex items-center gap-1.5 font-bold tracking-[2px] text-[#E8E6E1]">
        Read
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </span>
    </div>
  </a>
) : (
  <a
    href={p.href}
    data-cat={p.cat}
    class="post-card block rounded-[16px] overflow-hidden transition-all duration-[350ms] group relative text-[#E8E6E1]"
  >
    <div class="relative overflow-hidden rounded-[16px]" style={`aspect-ratio:${p.ar};`}>
      <img src={p.img} srcset={p.imgSrcset} sizes={p.imgSizes} alt={p.imgAlt} loading="lazy" decoding="async" width="1200" height="800" class="w-full h-full object-cover transition-transform duration-[600ms] group-hover:scale-[1.04]" />
      <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 40%, rgba(22,25,16,0.85));"></div>
      <span class="absolute top-4 left-4 z-[2] px-2.5 py-1 rounded-full bg-[#E8E6E1]/92 text-[#3F261F] font-bold uppercase text-[9px] tracking-[2px] backdrop-blur-sm">{p.cat}</span>
      <div class="absolute left-0 right-0 bottom-0 p-6 z-[2]">
        <div class="flex items-center gap-2.5 text-[10.5px] tracking-[0.5px] uppercase text-[#DDDAD3]/80 mb-2" style="font-family:'JetBrains Mono',monospace;">
          <span>{p.date}</span>{p.read && <><span>·</span><span>{p.read}</span></>}
        </div>
        <h3 class="text-[#E8E6E1] leading-[1]" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:clamp(22px,2.5vw,30px); text-wrap:balance;">{p.title}</h3>
      </div>
    </div>
  </a>
)}
