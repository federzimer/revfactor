---
type Props = {
  href: string;
  cat: string;
  variant?: 'overlay' | 'text' | 'cedar' | 'moss';
  ar?: string;
  img?: string;
  imgSrcset?: string;
  imgSizes?: string;
  imgAlt?: string;
  date: string;
  read: string;
  title: string;
  excerpt?: string;
  quote?: string;
};

const {
  href,
  cat,
  variant = 'overlay',
  ar = '4/3',
  img,
  imgSrcset,
  imgSizes,
  imgAlt,
  date,
  read,
  title,
  excerpt,
  quote,
} = Astro.props;

const isText = variant === 'text';
const isDark = variant === 'cedar' || variant === 'moss';
const darkBg = variant === 'moss' ? '#5D6D59' : '#13342D';
---

<a
  href={href}
  class:list={[
    'post-card group block overflow-hidden rounded-[16px] border transition-transform duration-200 hover:scale-[1.01]',
    isDark ? 'border-transparent text-[#E8E6E1]' : 'border-[#C8C4BC]/45 bg-white/60 text-[#3F261F]',
  ]}
  style={isDark ? `background:${darkBg};` : undefined}
  data-cat={cat}
>
  {!isText && img && (
    <div class="relative overflow-hidden" style={`aspect-ratio:${ar};`}>
      <img
        src={img}
        srcset={imgSrcset}
        sizes={imgSizes}
        alt={imgAlt || title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
      />
      {variant === 'overlay' && <div class="absolute inset-0 bg-gradient-to-t from-[#161910]/82 via-[#161910]/18 to-transparent"></div>}
      {variant === 'overlay' && (
        <div class="absolute inset-x-0 bottom-0 p-5 text-[#E8E6E1]">
          <div class="mb-3 flex items-center gap-2 text-[9px] font-bold uppercase tracking-[2px] text-[#C8C4BC]">
            <span>{cat}</span>
            <span>·</span>
            <span>{date}</span>
            {read && <span>·</span>}
            {read && <span>{read}</span>}
          </div>
          <h3 class="text-[26px] leading-[1.05]" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;">
            {title}
          </h3>
        </div>
      )}
    </div>
  )}

  {variant !== 'overlay' && (
    <div class="p-6">
      <div class:list={['mb-4 flex items-center gap-2 text-[9px] font-bold uppercase tracking-[2px]', isDark ? 'text-[#C8C4BC]' : 'text-[#8F6E62]']}>
        <span>{cat}</span>
        <span>·</span>
        <span>{date}</span>
        {read && <span>·</span>}
        {read && <span>{read}</span>}
      </div>
      <h3 class="text-[28px] leading-[1.08]" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;">
        {title}
      </h3>
      {(quote || excerpt) && (
        <p class:list={['mt-4 text-[14px] leading-[1.65]', isDark ? 'text-[#DDDAD3]/82' : 'text-[#76574C]']}>
          {quote || excerpt}
        </p>
      )}
    </div>
  )}
</a>
