---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.jsx';
import Footer from '../../components/Footer.jsx';

const studies = (await getCollection('caseStudies')).sort(
  (a, b) => (b.data.pacing?.liftPct ?? 0) - (a.data.pacing?.liftPct ?? 0)
);

// Q1 2026 candidates: high-level table on the index page; detail pages will be
// added once owner sign-off lands and tactical context is filled in. Source: the
// Q1 tab of /Files/Summer 2026 (OTB pacing).xlsx, 2026-05-04 export.
const q1Highlights = [
  { listing: 'Hues Casita — Airy Studio Near U of A', city: 'Tucson, AZ', br: 0, rev: 10222, ly: 1668, lift: 512.7, mpi: 1.15 },
  { listing: 'Skiing, Hot Tub & VIEWS', city: 'Durham, NY', br: 4, rev: 36096, ly: 6623, lift: 445.0, mpi: 1.31 },
  { listing: 'Desert Hues — B&B', city: 'Tucson, AZ', br: 3, rev: 29874, ly: 7753, lift: 285.3, mpi: 1.01 },
  { listing: 'Hutton House', city: 'Minneapolis, MN', br: 3, rev: 8929, ly: 3530, lift: 152.9, mpi: 1.19 },
  { listing: 'Elm Rd — Cabin near Helen', city: 'Cleveland, GA', br: 4, rev: 7600, ly: 3253, lift: 133.7, mpi: 1.50 },
  { listing: 'Armstrong — Historic Home near UT', city: 'Knoxville, TN', br: 6, rev: 12005, ly: 5235, lift: 129.3, mpi: 0.74 },
  { listing: 'Cabin in the Canyon', city: 'Glenwood Springs, CO', br: 2, rev: 36273, ly: 28423, lift: 27.6, mpi: 1.68 },
  { listing: 'Hillside Retreat', city: 'Denton Twp, MI', br: 6, rev: 38201, ly: 30740, lift: 24.3, mpi: 1.37 },
  { listing: 'Sanctuary at Kettle Creek', city: 'Pittman Center, TN', br: 5, rev: 51197, ly: 42500, lift: 20.5, mpi: 1.70 },
  { listing: 'Magnificent Hillsdale Oasis', city: 'Hillsdale, NY', br: 7, rev: 30422, ly: 27443, lift: 10.9, mpi: 1.10 },
];

const fmt = (n: number) => '$' + n.toLocaleString('en-US');
const fmtPct = (n: number) => (n >= 0 ? '+' : '') + n.toFixed(1) + '%';

// CollectionPage schema
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "RevFactor Case Studies",
  "description": "Documented revenue-management results across short-term rental properties under RevFactor management: pacing, ADR, and Market Penetration data for Summer 2026 and Q1 2026.",
  "url": "https://www.revfactor.io/case-studies",
  "publisher": {
    "@type": "Organization",
    "name": "RevFactor",
    "url": "https://www.revfactor.io"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.revfactor.io" },
    { "@type": "ListItem", "position": 2, "name": "Case Studies", "item": "https://www.revfactor.io/case-studies" }
  ]
};
---

<BaseLayout
  title="Case Studies | RevFactor | Documented STR Revenue Management Results"
  description="Documented +57% to +293% summer-pacing lifts across short-term rental properties under RevFactor management. Real data, real properties, real markets."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Navbar client:load />

  <main class="min-h-screen bg-[#DDDAD3]">
    <!-- Header -->
    <section class="pt-32 md:pt-40 pb-12 md:pb-16">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="mb-8">
          <ol class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[2px] text-[#8F6E62]">
            <li><a href="/" class="hover:text-[#3F261F] transition-colors">Home</a></li>
            <li aria-hidden="true" class="opacity-40">/</li>
            <li aria-current="page" class="text-[#3F261F]">Case Studies</li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          <p class="font-bold uppercase text-[9px] tracking-[3px] text-[#8F6E62] mb-5">
            DOCUMENTED RESULTS
          </p>
          <h1
            class="text-[clamp(36px,7vw,64px)] leading-[1.05] text-[#3F261F] mb-5"
            style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; letter-spacing: 0.5px;"
          >
            Case<br />
            <em style="font-style: italic; color: #7A8B76;">studies</em>
          </h1>
          <p class="text-[15px] leading-[1.7] text-[#76574C] max-w-xl mb-2">
            Real properties, real markets, real numbers. Each study below is sourced from RevFactor's pacing reports: on-the-books revenue, ADR, and Market Penetration Index against same-time-last-year and final-year baselines.
          </p>
          <p class="text-[12px] leading-[1.6] text-[#8F6E62] max-w-xl italic">
            Past performance is not indicative of future results. Owner names are abbreviated where written sign-off is pending.
          </p>
        </div>
      </div>
    </section>

    <!-- Summer 2026 pacing: featured -->
    <section class="pb-16 md:pb-24">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="flex items-end justify-between mb-8 pb-4 border-b border-[#C8C4BC]">
          <div>
            <p class="font-bold uppercase text-[9px] tracking-[3px] text-[#5D6D59] mb-2">SUMMER 2026 · ON-THE-BOOKS PACING</p>
            <h2
              class="text-[clamp(24px,3.5vw,36px)] leading-[1.15] text-[#3F261F]"
              style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400;"
            >
              Seven properties. <em style="font-style: italic; color: #7A8B76;">Three months of comparable data.</em>
            </h2>
          </div>
          <div class="hidden md:block text-right">
            <p class="text-[11px] font-bold uppercase tracking-[2px] text-[#8F6E62]">Comparison window</p>
            <p class="text-[14px] text-[#3F261F]" style="font-family: 'JetBrains Mono', monospace;">Jun–Aug 2026</p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {studies.map((study) => {
            const p = study.data.pacing;
            return (
              <article
                class="group bg-[#E8E6E1] rounded-[16px] overflow-hidden transition-all duration-[350ms]"
                style="box-shadow: 0 1px 3px rgba(22,25,16,0.06); transition-timing-function: cubic-bezier(0.25,0.1,0.25,1);"
                onmouseenter="this.style.transform='translateY(-2px) scale(1.01)';this.style.boxShadow='0 12px 32px rgba(22,25,16,0.10)'"
                onmouseleave="this.style.transform='';this.style.boxShadow='0 1px 3px rgba(22,25,16,0.06)'"
              >
                <a href={`/case-studies/${study.id}`} class="block p-7">
                  <div class="flex items-center gap-2 mb-4">
                    <span class="inline-block px-2.5 py-1 rounded-full bg-[#5D6D59]/10 text-[#5D6D59] font-bold uppercase text-[8px] tracking-[2px]">
                      {study.data.bedrooms} BR
                    </span>
                    <span class="text-[10px] font-bold uppercase tracking-[1.5px] text-[#8F6E62]">
                      {study.data.city}, {study.data.state}
                    </span>
                  </div>

                  <h3
                    class="text-[clamp(20px,2.5vw,26px)] leading-[1.2] text-[#3F261F] mb-3 group-hover:text-[#13342D] transition-colors"
                    style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400;"
                  >
                    {study.data.listing}
                  </h3>

                  {p && (
                    <div class="mb-5 grid grid-cols-2 gap-3 py-3 border-y border-[#C8C4BC]/40">
                      <div>
                        <p class="text-[9px] font-bold uppercase tracking-[2px] text-[#8F6E62] mb-1">vs. STLY</p>
                        <p class="text-[18px] text-[#5D6D59]" style="font-family: 'JetBrains Mono', monospace; font-weight: 500;">{fmtPct(p.liftPct)}</p>
                      </div>
                      <div>
                        <p class="text-[9px] font-bold uppercase tracking-[2px] text-[#8F6E62] mb-1">MPI</p>
                        <p class="text-[18px] text-[#3F261F]" style="font-family: 'JetBrains Mono', monospace; font-weight: 500;">{p.mpi?.toFixed(2)}×</p>
                      </div>
                      <div>
                        <p class="text-[9px] font-bold uppercase tracking-[2px] text-[#8F6E62] mb-1">OTB Rev</p>
                        <p class="text-[14px] text-[#3F261F]" style="font-family: 'JetBrains Mono', monospace;">{fmt(p.otbRev)}</p>
                      </div>
                      <div>
                        <p class="text-[9px] font-bold uppercase tracking-[2px] text-[#8F6E62] mb-1">$ Lift</p>
                        <p class="text-[14px] text-[#5D6D59]" style="font-family: 'JetBrains Mono', monospace;">+{fmt(p.otbRev - p.stlyRev)}</p>
                      </div>
                    </div>
                  )}

                  <p class="text-[13px] leading-[1.6] text-[#76574C] mb-4 line-clamp-3">
                    {study.data.description}
                  </p>

                  <span class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[2px] text-[#13342D] group-hover:gap-3 transition-all">
                    Read case study
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Q1 2026 highlights: table -->
    <section class="pb-16 md:pb-24 bg-[#E8E6E1]">
      <div class="max-w-7xl mx-auto px-6 md:px-12 pt-16 md:pt-20">
        <div class="mb-8 pb-4 border-b border-[#C8C4BC]">
          <p class="font-bold uppercase text-[9px] tracking-[3px] text-[#5D6D59] mb-2">Q1 2026 · ACTUALS</p>
          <h2
            class="text-[clamp(24px,3.5vw,36px)] leading-[1.15] text-[#3F261F] mb-3"
            style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400;"
          >
            Top Q1 lifts <em style="font-style: italic; color: #7A8B76;">across the portfolio.</em>
          </h2>
          <p class="text-[14px] leading-[1.6] text-[#76574C] max-w-2xl">
            Twenty-four RevFactor-managed properties posted positive Q1 2026 revenue lifts vs. Q1 2025. The ten with the largest lifts are below. Full case studies for these properties are in production.
          </p>
        </div>

        <div class="overflow-x-auto rounded-[16px] bg-[#DDDAD3] border border-[#C8C4BC]/60">
          <table class="w-full text-left">
            <thead class="bg-[#13342D] text-[#E8E6E1]">
              <tr>
                <th class="px-5 py-4 font-bold uppercase text-[9px] tracking-[2px]">Listing</th>
                <th class="px-5 py-4 font-bold uppercase text-[9px] tracking-[2px]">Market</th>
                <th class="px-5 py-4 font-bold uppercase text-[9px] tracking-[2px] text-right">BR</th>
                <th class="px-5 py-4 font-bold uppercase text-[9px] tracking-[2px] text-right">Q1 Rev</th>
                <th class="px-5 py-4 font-bold uppercase text-[9px] tracking-[2px] text-right">vs. LY</th>
                <th class="px-5 py-4 font-bold uppercase text-[9px] tracking-[2px] text-right">$ Lift</th>
                <th class="px-5 py-4 font-bold uppercase text-[9px] tracking-[2px] text-right">MPI</th>
              </tr>
            </thead>
            <tbody>
              {q1Highlights.map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-[#DDDAD3]' : 'bg-[#E8E6E1]/50'}>
                  <td class="px-5 py-3.5 text-[13px] text-[#3F261F]" style="font-family: 'Cormorant Garamond', Georgia, serif;">{row.listing}</td>
                  <td class="px-5 py-3.5 text-[12px] text-[#76574C]">{row.city}</td>
                  <td class="px-5 py-3.5 text-[12px] text-[#3F261F] text-right" style="font-family: 'JetBrains Mono', monospace;">{row.br || 'n/a'}</td>
                  <td class="px-5 py-3.5 text-[12px] text-[#3F261F] text-right" style="font-family: 'JetBrains Mono', monospace;">{fmt(row.rev)}</td>
                  <td class="px-5 py-3.5 text-[12px] text-[#5D6D59] text-right" style="font-family: 'JetBrains Mono', monospace; font-weight: 500;">{fmtPct(row.lift)}</td>
                  <td class="px-5 py-3.5 text-[12px] text-[#5D6D59] text-right" style="font-family: 'JetBrains Mono', monospace;">+{fmt(row.rev - row.ly)}</td>
                  <td class="px-5 py-3.5 text-[12px] text-[#3F261F] text-right" style="font-family: 'JetBrains Mono', monospace;">{row.mpi.toFixed(2)}×</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-[11px] text-[#8F6E62] mt-4 italic">
          Source: RevFactor pacing reports, May 2026 export. "MPI" = Market Penetration Index (1.0× = pacing the market; &gt;1.0 = leading).
        </p>
      </div>
    </section>

    <!-- Methodology -->
    <section class="py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-6 md:px-12">
        <p class="font-bold uppercase text-[9px] tracking-[3px] text-[#8F6E62] mb-4">METHODOLOGY</p>
        <h2
          class="text-[clamp(22px,3vw,30px)] leading-[1.2] text-[#3F261F] mb-6"
          style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400;"
        >
          How to read these numbers.
        </h2>
        <dl class="space-y-5 text-[14px] leading-[1.7] text-[#76574C]">
          <div>
            <dt class="font-bold text-[#3F261F]">OTB (on-the-books) revenue</dt>
            <dd>Revenue already committed via signed bookings for the comparison window, as of the data-pull date.</dd>
          </div>
          <div>
            <dt class="font-bold text-[#3F261F]">STLY (same-time-last-year)</dt>
            <dd>The comparable booking-curve point in the prior year, meaning what the calendar held a year ago for the same future window. The cleanest apples-to-apples pacing comparison.</dd>
          </div>
          <div>
            <dt class="font-bold text-[#3F261F]">LY (last-year final)</dt>
            <dd>Final realized revenue for the same window in the prior year. Useful for benchmarking the magnitude of the swing once peak weeks finish booking.</dd>
          </div>
          <div>
            <dt class="font-bold text-[#3F261F]">MPI (Market Penetration Index)</dt>
            <dd>The property's share of bookings divided by what its share would be if all comp-set listings booked at equal rates. 1.00× = pacing the market; &gt;1.00× = leading; &lt;1.00× = trailing.</dd>
          </div>
          <div>
            <dt class="font-bold text-[#3F261F]">ADR (Average Daily Rate)</dt>
            <dd>Average price of booked nights. Useful as a directional signal but never alone. High ADR with low occupancy can mean the rate is wrong.</dd>
          </div>
        </dl>
        <p class="text-[12px] text-[#8F6E62] mt-8 italic">
          Past performance is not indicative of future results. Numbers reflect data as of May 2026; final outcomes may vary as booking windows close.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 md:py-20 bg-[#13342D] text-[#E8E6E1]">
      <div class="max-w-3xl mx-auto px-6 md:px-12 text-center">
        <p class="font-bold uppercase text-[9px] tracking-[3px] text-[#A9BBA3] mb-4">YOUR NUMBERS, NEXT</p>
        <h2
          class="text-[clamp(28px,4vw,42px)] leading-[1.15] mb-6"
          style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400;"
        >
          What would your <em style="font-style: italic; color: #A9BBA3;">comp-set look like</em> with this kind of pacing?
        </h2>
        <p class="text-[15px] leading-[1.7] text-[#A9BBA3]/80 mb-8 max-w-xl mx-auto">
          A 30-minute strategy call. We pull your comp-set, walk through where pacing is leaving money, and tell you whether RevFactor is the right fit. No pitch deck.
        </p>
        <a
          href="/#schedule"
          class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#A9BBA3] text-[#13342D] font-bold uppercase text-[11px] tracking-[2px] rounded-full hover:scale-[1.02] transition-transform"
          data-umami-event="case-studies-cta-click"
        >
          Book a strategy call →
        </a>
      </div>
    </section>
  </main>

  <Footer client:load />
</BaseLayout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
