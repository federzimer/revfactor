---
// Single-post template — Layout 2 (Immersive)
// Ported from src/pages/blog-mockups/post-immersive.astro into a content-collection-driven template.
// Hero headline reduced from clamp(56px,9vw,140px) to clamp(34px,4.5vw,56px) so it reads at journal scale.

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.jsx';
import Footer from '../../components/Footer.jsx';
import BlogScheduleCTA from '../../components/BlogScheduleCTA.jsx';

// Federico author headshot — used in hero metadata + bottom author card
const FEDE_PHOTO = '/blog/revenue-management-for-short-term-rentals/federico-author.jpg';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});

const toc = headings.filter((h) => h.depth === 2).map((h) => ({
  href: `#${h.slug}`,
  label: h.text,
}));

const otherPosts = allPosts.filter((p) => p.id !== post.id);
const sameCategory = otherPosts.filter((p) => p.data.category === post.data.category);
const relatedSource = [...sameCategory, ...otherPosts.filter((p) => p.data.category !== post.data.category)];
const related = relatedSource.slice(0, 3).map((p) => ({
  href: `/blog/${p.id}`,
  cat: p.data.category,
  date: p.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
  read: p.data.readingTime ? `${p.data.readingTime} min` : '8 min',
  title: p.data.title,
  img: p.data.image || 'https://images.unsplash.com/photo-1502784444187-359ac186c5bb?auto=format&fit=crop&w=1000&q=80',
}));

const heroImage = post.data.image || '/heroes/aframe-1920.webp';
const heroAlt = post.data.imageAlt || post.data.title;

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": heroImage.startsWith('http') ? heroImage : `https://revfactor.io${heroImage}`,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  "author": { "@type": "Person", "name": post.data.author, "url": "https://revfactor.io/about" },
  "publisher": {
    "@type": "Organization",
    "name": "RevFactor",
    "url": "https://revfactor.io",
    "logo": { "@type": "ImageObject", "url": "https://revfactor.io/og-image.png" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": Astro.url.href },
  "keywords": post.data.tags.join(', '),
  "articleSection": post.data.category
};
---

<BaseLayout
  title={`${post.data.title} — The Curve`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  author={post.data.author}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <Navbar client:load />

  <div id="progressBar" class="fixed top-0 left-0 h-[3px] bg-[#A9BBA3] z-[100] transition-[width] duration-75" style="width:0;"></div>

  <article>
    <!-- IMMERSIVE FULL-BLEED HERO — sized to the image's native ~1.83 wide aspect -->
    <section class="relative overflow-hidden text-[#E8E6E1]" style="height:78vh; min-height:580px; max-height:820px; background-color:#13342D;">
      <!-- Image as <img> (more reliable fill than bg-image), object-cover, parallax-ready -->
      <img
        id="heroBg"
        src={heroImage}
        alt={heroAlt}
        class="absolute inset-0 w-full h-full object-cover will-change-transform"
        style="transform:scale(1.08); z-index:0;"
      />
      <!-- Top gradient — for navbar legibility (bright sky needs strong overlay) -->
      <div class="absolute top-0 left-0 right-0 h-56 z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(22,25,16,0.9) 0%, rgba(22,25,16,0.6) 35%, rgba(22,25,16,0.15) 80%, rgba(22,25,16,0) 100%);"></div>
      <!-- Bottom gradient — strengthened for body-text legibility over bright skies -->
      <div class="absolute bottom-0 left-0 right-0 h-[70%] z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(22,25,16,0) 0%, rgba(22,25,16,0.45) 30%, rgba(22,25,16,0.78) 60%, rgba(22,25,16,0.95) 100%);"></div>

      <div class="relative z-[2] max-w-7xl mx-auto px-6 md:px-12 h-full flex flex-col justify-end pb-20 pt-36">
        <span class="font-bold uppercase text-[9px] tracking-[3px] text-[#A9BBA3] mb-6 inline-block">
          {post.data.category} · Field Report
        </span>

        <h1
          class="text-[#E8E6E1] mb-6"
          style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:clamp(38px,5.2vw,72px); line-height:1.05; letter-spacing:0.5px; max-width:1000px;"
        >
          {post.data.title}
        </h1>

        <p
          class="mb-10 max-w-2xl"
          style="font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-weight:300; font-size:clamp(17px,1.8vw,22px); color:rgba(221,218,211,0.9); line-height:1.4;"
        >
          {post.data.description}
        </p>

        <div class="flex gap-12 flex-wrap pt-7 border-t border-[#DDDAD3]/25" style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(221,218,211,0.7); letter-spacing:0.5px; text-transform:uppercase;">
          <div>
            <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#E8E6E1] mb-1.5" style="font-family:inherit;">Published</div>
            <div>{formattedDate}</div>
          </div>
          {post.data.readingTime && (
            <div>
              <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#E8E6E1] mb-1.5" style="font-family:inherit;">Read time</div>
              <div>{post.data.readingTime} minutes</div>
            </div>
          )}
          <div>
            <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#E8E6E1] mb-1.5" style="font-family:inherit;">Category</div>
            <div>{post.data.category}</div>
          </div>
          <div class="flex items-center gap-3">
            <img
              src={FEDE_PHOTO}
              alt="Federico Zimerman"
              class="w-10 h-10 rounded-full object-cover ring-1 ring-[#DDDAD3]/30"
            />
            <div>
              <div class="text-[16px] text-[#E8E6E1] lowercase" style="font-family:'Cormorant Garamond',Georgia,serif;">{post.data.author.toLowerCase()}</div>
              <div class="font-bold uppercase text-[9px] tracking-[2px] text-[#DDDAD3]/70">Founder · RevFactor</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-6 md:px-12 grid md:grid-cols-[1fr_240px] gap-16 md:gap-20 py-20">
      <div class="max-w-2xl min-w-0 ml-auto">
        <div class="prose-rf">
          <Content />
        </div>

        {post.data.tags.length > 0 && (
          <div class="mt-16 pt-8 border-t border-[#C8C4BC]">
            <p class="font-bold uppercase text-[9px] tracking-[2.5px] text-[#8F6E62] mb-3">Topics</p>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="px-3 py-1 bg-[#E8E6E1] text-[#76574C] text-[12px] rounded-full border border-[#C8C4BC]">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <div class="mt-16 p-8 rounded-[16px] bg-[#E8E6E1] border border-[#C8C4BC] flex gap-6 items-start flex-wrap md:flex-nowrap">
          <img
            src={FEDE_PHOTO}
            alt="Federico Zimerman"
            class="w-20 h-20 rounded-full object-cover flex-shrink-0 ring-1 ring-[#C8C4BC]"
          />
          <div>
            <h4 class="text-[22px] text-[#3F261F] mb-1" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;">{post.data.author.toLowerCase()}</h4>
            <div class="font-bold uppercase text-[9px] tracking-[2px] text-[#8F6E62] mb-4">Founder · RevFactor</div>
            <p class="text-[14px] leading-[1.6] text-[#76574C] mb-4">Federico spent 10 years in airline revenue management at American Airlines before applying those principles to short-term rentals. RevFactor's pricing strategies are battle-tested across 165+ properties in 24 states.</p>
            <div class="flex gap-2 flex-wrap">
              <a href="https://www.linkedin.com/in/federico-zimerman-23ab3345/" target="_blank" rel="noopener" class="px-3 py-1.5 rounded-full border border-[#C8C4BC] text-[11px] font-bold uppercase tracking-[1.5px] text-[#3F261F] hover:border-[#3F261F] transition-colors">Follow on LinkedIn</a>
              <a href="/journal" class="px-3 py-1.5 rounded-full border border-[#C8C4BC] text-[11px] font-bold uppercase tracking-[1.5px] text-[#3F261F] hover:border-[#3F261F] transition-colors">More essays</a>
            </div>
          </div>
        </div>
      </div>

      <aside class="md:sticky md:top-24 md:self-start md:pl-6 md:border-l border-[#C8C4BC]">
        <h5 class="font-bold uppercase text-[9px] tracking-[2.5px] text-[#8F6E62] mb-4">In this essay</h5>
        <ul class="space-y-2.5" id="toc">
          {toc.map((item, i) => (
            <li>
              <a href={item.href} class="toc-link flex items-baseline gap-2 text-[13px] leading-[1.4] text-[#76574C] hover:text-[#13342D] transition-colors">
                <span class="flex-shrink-0 text-[#C8C4BC] tabular-nums" style="font-family:'JetBrains Mono',monospace; min-width:22px;">{String(i + 1).padStart(2, '0')}</span>
                <span class="block">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="max-w-7xl mx-auto px-6 md:px-12 pb-24">
        <div class="flex items-end justify-between mb-10 flex-wrap gap-4">
          <div>
            <span class="font-bold uppercase text-[9px] tracking-[3px] text-[#8F6E62] mb-2 block">Keep reading</span>
            <h2 class="text-[#3F261F]" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:clamp(28px,3.5vw,40px);">Read more <em style="font-style:italic; color:#7A8B76;">from the Journal.</em></h2>
          </div>
          <a href="/journal" class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[2px] text-[#3F261F] hover:text-[#13342D] transition-colors">
            All field notes
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {related.map((p) => (
            <a href={p.href} class="group block">
              <div class="relative overflow-hidden rounded-[12px] mb-4" style="aspect-ratio:4/3;">
                <span class="absolute top-3 left-3 z-[2] px-2.5 py-1 rounded-full bg-[#E8E6E1]/92 text-[#3F261F] font-bold uppercase text-[9px] tracking-[2px] backdrop-blur-sm">{p.cat}</span>
                <img src={p.img} alt="" class="w-full h-full object-cover transition-transform duration-[600ms] group-hover:scale-[1.04]"/>
              </div>
              <div class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[1.5px] text-[#8F6E62] mb-2">
                <span>{p.date}</span><span>·</span><span>{p.read}</span>
              </div>
              <h3 class="text-[20px] leading-[1.15] text-[#3F261F] group-hover:text-[#13342D] transition-colors" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;">{p.title}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="max-w-7xl mx-auto px-6 md:px-12 pb-24">
      <div class="p-10 md:p-16 bg-[#13342D] rounded-[24px] text-center">
        <p class="font-bold uppercase text-[9px] tracking-[3px] text-[#7A8B76] mb-4">Ready to optimize your revenue?</p>
        <h2 class="text-[clamp(28px,4vw,42px)] leading-[1.15] text-[#E8E6E1] mb-5 mx-auto max-w-2xl" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;">
          Let's talk about your <em style="font-style:italic; color:#7A8B76;">properties.</em>
        </h2>
        <p class="text-[15px] leading-[1.7] text-[#CCC8BF] mb-8 max-w-md mx-auto">
          Schedule a free 30-minute discovery call to see what expert revenue management could do for your STR portfolio.
        </p>
        <BlogScheduleCTA client:load />
      </div>
    </section>
  </article>

  <Footer client:load />

  <style>
    /* Body — sans-serif (Helvetica) per brand spec; serif reserved for headings + quotes */
    .prose-rf :global(p) { font-family:Helvetica,'Helvetica Neue',Arial,sans-serif; font-size:17px; line-height:1.7; color:#3F261F; margin:0 0 1.25em; }
    @media (max-width: 640px) { .prose-rf :global(p) { font-size:16px; line-height:1.65; } }

    /* H2 / H3 — Cormorant, weight bumped 500 to match homepage hero feel */
    .prose-rf :global(h2) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:clamp(32px,3.8vw,46px); line-height:1.15; color:#3F261F; margin:1.75em 0 0.6em; letter-spacing:0.25px; }
    .prose-rf :global(h3) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:clamp(24px,2.8vw,32px); line-height:1.2; color:#3F261F; margin:1.5em 0 0.4em; letter-spacing:0.25px; }

    /* Lists — sans-serif body */
    .prose-rf :global(ol),
    .prose-rf :global(ul) { font-family:Helvetica,'Helvetica Neue',Arial,sans-serif; font-size:16px; line-height:1.7; color:#3F261F; padding-left:1.5em; margin:0 0 1.25em; }
    @media (max-width: 640px) {
      .prose-rf :global(ol),
      .prose-rf :global(ul) { font-size:15px; }
    }
    .prose-rf :global(ol) { list-style: decimal; }
    .prose-rf :global(ul) { list-style: disc; }
    .prose-rf :global(li) { margin-bottom: 0.6em; }
    .prose-rf :global(li::marker) { color: #5D6D59; }
    .prose-rf :global(strong) { color:#13342D; font-weight:700; }
    /* Italics — Cormorant serif in cedar (darker green) per Aaron */
    .prose-rf :global(em)     { font-family:'Cormorant Garamond',Georgia,serif; color:#13342D; font-style:italic; }
    .prose-rf :global(a)      { color:#13342D; text-decoration:underline; text-underline-offset:3px; }
    .prose-rf :global(a:hover){ color:#1E4A40; }
    .prose-rf :global(hr)     { border:none; border-top:1px solid #C8C4BC; margin:2.5rem 0; }

    /* Drop cap — Cormorant serif accent on the first body paragraph; line-height tightened
       so the second body line doesn't get pushed away from the first */
    .prose-rf > :global(p:first-of-type::first-letter) {
      float:left;
      font-family:'Cormorant Garamond',Georgia,serif;
      font-weight:500;
      color:#13342D;
      font-size:56px;
      line-height:0.85;
      padding-top:4px;
      margin-right:10px;
      margin-top:0;
    }
    @media (max-width: 640px) {
      .prose-rf > :global(p:first-of-type::first-letter) { font-size:42px; }
    }

    /* Blockquote — text uses cedar dark green per Aaron, easier to read */
    .prose-rf :global(blockquote) { border-left:4px solid #5D6D59; padding:0.5rem 0 0.5rem 1.5rem; margin:2rem 0; background:transparent; }
    .prose-rf :global(blockquote p) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-weight:400; font-size:clamp(22px,2.6vw,28px); line-height:1.3; color:#13342D; margin:0; }

    .prose-rf :global(code) { font-family:'JetBrains Mono',monospace; font-size:14px; background:#C8C4BC; color:#13342D; padding:0.15em 0.45em; border-radius:4px; }

    /* Tables — body cells now 16px, mono numerics, with horizontal scroll on narrow viewports */
    .prose-rf :global(table) { width:100%; border-collapse:collapse; margin:1.75rem 0; font-size:16px; display:block; overflow-x:auto; }
    @media (min-width: 768px) { .prose-rf :global(table) { display:table; } }
    .prose-rf :global(table thead) { border-bottom:2px solid #3F261F; }
    .prose-rf :global(table th) { text-align:left; padding:14px 14px; font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:11px; letter-spacing:2px; text-transform:uppercase; color:#3F261F; white-space:nowrap; }
    .prose-rf :global(table td) { padding:16px 14px; font-family:'JetBrains Mono',monospace; font-size:15px; color:#3F261F; border-bottom:1px solid #C8C4BC; vertical-align:top; }
    .prose-rf :global(table td:first-child) { font-family:'Cormorant Garamond',Georgia,serif; font-size:17px; font-weight:500; color:#13342D; }
    .prose-rf :global(table tr:last-child td) { border-bottom:none; }
    .prose-rf :global(table strong) { color:#13342D; }

    /* Figures break out of body container so graphics get more breathing room (instead of cramped at 672px).
       Body is ml-auto inside a 1fr column with a 240px sticky TOC on the right — so we extend LEFT only,
       not right, otherwise the TOC's border-left runs through the card (Aaron's #4 leak fix). */
    .prose-rf :global(.rf-figure) {
      margin:2.5rem 0;
      text-align:center;
      margin-left: clamp(-8rem, -10vw, -2rem);
      margin-right: 0;
    }
    @media (max-width: 768px) {
      .prose-rf :global(.rf-figure) { margin-left:0; }
    }
    .prose-rf :global(.rf-figure img) { width:100%; height:auto; border-radius:16px; display:block; }
    .prose-rf :global(.rf-figure figcaption) {
      font-family:'Cormorant Garamond',Georgia,serif;
      font-style:italic;
      font-size:15px;
      color:#76574C;
      margin-top:0.9rem;
      padding:0 1.5rem;
      line-height:1.4;
    }

    .prose-rf :global(.rf-quick-answer) { background:#13342D; color:#E8E6E1; border-radius:16px; padding:2rem 2.25rem; margin:2.5rem 0; }
    .prose-rf :global(.rf-quick-answer .kicker) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:9px; letter-spacing:2.5px; color:#7A8B76; margin:0 0 0.85rem; }
    .prose-rf :global(.rf-quick-answer p:last-child) { font-family:'Cormorant Garamond',Georgia,serif; color:#E8E6E1; font-size:19px; line-height:1.5; margin:0; }

    .prose-rf :global(.rf-key-stats) { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin:2.5rem 0; padding:1.5rem; background:rgba(93,109,89,0.08); border:1px solid rgba(93,109,89,0.2); border-radius:16px; }
    @media (max-width: 640px) { .prose-rf :global(.rf-key-stats) { grid-template-columns:1fr; } }
    .prose-rf :global(.rf-key-stats .label) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:8.5px; letter-spacing:1.5px; text-transform:uppercase; color:#5D6D59; margin:0 0 0.4rem; text-align:center; }
    .prose-rf :global(.rf-key-stats .number) { font-family:'JetBrains Mono',monospace; font-weight:500; font-size:clamp(22px,3vw,32px); color:#13342D; margin:0 0 0.25rem; text-align:center; line-height:1; }
    .prose-rf :global(.rf-key-stats .caption) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:13px; color:#76574C; margin:0; text-align:center; }

    /* Key Takeaways — heading serif, body sans-serif per brand spec */
    .prose-rf :global(.rf-takeaways) { background:rgba(93,109,89,0.05); border:1px solid #C8C4BC; border-radius:16px; padding:1.75rem 2rem; margin:2.5rem 0; }
    .prose-rf :global(.rf-takeaways h3) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:30px; color:#13342D; margin:0 0 1rem !important; letter-spacing:0.25px; }
    .prose-rf :global(.rf-takeaways ul) { margin:0; padding-left:1.25rem; }
    .prose-rf :global(.rf-takeaways li) { font-family:Helvetica,'Helvetica Neue',Arial,sans-serif; font-size:16px; line-height:1.65; color:#3F261F; margin-bottom:0.7rem; }
    @media (max-width: 640px) {
      .prose-rf :global(.rf-takeaways li) { font-size:15px; }
    }

    .prose-rf :global(.rf-author-bio) { display:none; }
    .prose-rf :global(.rf-hero) { display:none; }

    /* ============== HTML GRID COMPONENTS (responsive, scale with text) ============== */

    /* Strategic Philosophy — 3 cards (cedar / moss / tobacco). Break out LEFT only (TOC is on right). */
    .prose-rf :global(.rf-philosophy) {
      margin:2.5rem 0;
      margin-left: clamp(-8rem, -10vw, -2rem);
      margin-right: 0;
    }
    @media (max-width: 768px) { .prose-rf :global(.rf-philosophy) { margin-left:0; } }
    .prose-rf :global(.rf-philosophy-header) { text-align:center; margin-bottom:1.75rem; }
    .prose-rf :global(.rf-philosophy-header .kicker) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#76574C; margin:0 0 0.75rem; }
    .prose-rf :global(.rf-philosophy-header h3) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-weight:400; font-size:clamp(32px,4vw,48px); color:#13342D; margin:0 0 0.5rem !important; }
    .prose-rf :global(.rf-philosophy-header .lede) { font-family:'Cormorant Garamond',Georgia,serif; font-size:18px; color:#76574C; margin:0; line-height:1.4; }

    .prose-rf :global(.rf-philosophy-grid) {
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:1.25rem;
      margin-top:1.5rem;
    }
    @media (max-width: 768px) { .prose-rf :global(.rf-philosophy-grid) { grid-template-columns:1fr; } }
    .prose-rf :global(.rf-philosophy-card) {
      border-radius:16px;
      padding:2rem 1.5rem;
      text-align:center;
      color:#DDDAD3;
      min-height: 320px;
      display:flex;
      flex-direction:column;
      justify-content:flex-start;
    }
    .prose-rf :global(.rf-philosophy-card.cedar)   { background:#13342D; }
    .prose-rf :global(.rf-philosophy-card.moss)    { background:#5D6D59; }
    .prose-rf :global(.rf-philosophy-card.tobacco) { background:#3F261F; }
    .prose-rf :global(.rf-philosophy-card .num) { font-family:'JetBrains Mono',monospace; font-weight:500; font-size:56px; line-height:1; margin:0 0 0.5rem; opacity:0.85; }
    .prose-rf :global(.rf-philosophy-card.cedar .num)   { color:#A9BBA3; }
    .prose-rf :global(.rf-philosophy-card.moss .num)    { color:#13342D; }
    .prose-rf :global(.rf-philosophy-card.tobacco .num) { color:#A9BBA3; }
    .prose-rf :global(.rf-philosophy-card .rule) { width:48px; height:1px; background:currentColor; opacity:0.5; margin:0 auto 1rem; }
    .prose-rf :global(.rf-philosophy-card .label) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:13px; letter-spacing:3px; text-transform:uppercase; opacity:1; color:#E8E6E1 !important; margin:0 0 1.25rem !important; }
    .prose-rf :global(.rf-philosophy-card.moss .label) { color:#13342D !important; }
    .prose-rf :global(.rf-philosophy-card .lead) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-weight:500; font-size:26px; line-height:1.2; margin:0 0 1.25rem !important; color:#E8E6E1 !important; }
    .prose-rf :global(.rf-philosophy-card.moss .lead) { color:#13342D !important; }
    .prose-rf :global(.rf-philosophy-card .body) { font-family:Helvetica,'Helvetica Neue',Arial,sans-serif; font-size:16px; line-height:1.55; opacity:1; color:#E8E6E1; margin:0 0 0.75rem !important; }
    .prose-rf :global(.rf-philosophy-card.moss .body) { color:#13342D; }
    .prose-rf :global(.rf-philosophy-card .pull) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:15px; opacity:0.85; color:#E8E6E1; margin:auto 0 0 !important; padding-top:1rem; }
    .prose-rf :global(.rf-philosophy-card.moss .pull) { color:#13342D; }
    /* Philosophy cards override the global em → cedar rule so italic text inside cards
       inherits the card's text color (not moss, which goes invisible on moss/cedar bg) */
    .prose-rf :global(.rf-philosophy-card em) { color:inherit !important; font-family:inherit; }

    /* 7 Leaks — 4-up responsive grid. Break out LEFT only (TOC is on right). */
    .prose-rf :global(.rf-leaks) {
      margin:2.5rem 0;
      margin-left: clamp(-8rem, -10vw, -2rem);
      margin-right: 0;
    }
    @media (max-width: 768px) { .prose-rf :global(.rf-leaks) { margin-left:0; } }
    .prose-rf :global(.rf-leaks-header) { text-align:center; margin-bottom:1.5rem; }
    .prose-rf :global(.rf-leaks-header .kicker) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#76574C; margin:0 0 0.75rem; }
    .prose-rf :global(.rf-leaks-header h3) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:clamp(32px,4vw,48px); color:#13342D; margin:0 0 0.5rem !important; }
    .prose-rf :global(.rf-leaks-header .lede) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:17px; color:#76574C; margin:0; line-height:1.4; }

    .prose-rf :global(.rf-leaks-grid) {
      display:grid;
      grid-template-columns: repeat(4, 1fr);
      gap:1rem;
      margin-top:1.5rem;
    }
    @media (max-width: 1100px) { .prose-rf :global(.rf-leaks-grid) { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 768px)  { .prose-rf :global(.rf-leaks-grid) { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px)  { .prose-rf :global(.rf-leaks-grid) { grid-template-columns: 1fr; } }

    .prose-rf :global(.rf-leak-card) {
      background:#E8E6E1;
      border-radius:12px;
      padding:1.5rem 1.25rem;
      position:relative;
      border-top:4px solid var(--leak-accent, #13342D);
    }
    .prose-rf :global(.rf-leak-card.cedar)   { --leak-accent:#13342D; }
    .prose-rf :global(.rf-leak-card.moss)    { --leak-accent:#5D6D59; }
    .prose-rf :global(.rf-leak-card.tobacco) { --leak-accent:#3F261F; }
    .prose-rf :global(.rf-leak-card.walnut)  { --leak-accent:#76574C; }
    .prose-rf :global(.rf-leak-card .num) { font-family:'JetBrains Mono',monospace; font-weight:500; font-size:42px; line-height:1; margin:0 0 0.65rem !important; color:var(--leak-accent); }
    .prose-rf :global(.rf-leak-card .label) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:10px; letter-spacing:1.8px; text-transform:uppercase; color:#5D6D59; margin:0 0 0.6rem !important; }
    .prose-rf :global(.rf-leak-card .title) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:23px; line-height:1.2; color:#13342D; margin:0 0 0.65rem !important; letter-spacing:0.25px; }
    .prose-rf :global(.rf-leak-card .body) { font-family:Helvetica,'Helvetica Neue',Arial,sans-serif; font-size:14px; line-height:1.6; color:#3F261F; margin:0 !important; }
    /* Override em color inside leak cards so italic doesn't go cedar-on-bone-on-cedar-accent */
    .prose-rf :global(.rf-leak-card em) { color:#13342D; }

    .toc-link.active { color:#13342D; font-weight:600; }
  </style>

  <script is:inline>
    const bar = document.getElementById('progressBar');
    const article = document.querySelector('article');
    const heroBg = document.getElementById('heroBg');
    const onScroll = () => {
      if (article && bar) {
        const rect = article.getBoundingClientRect();
        const total = article.offsetHeight - window.innerHeight;
        const scrolled = -rect.top;
        const pct = Math.max(0, Math.min(100, (scrolled / total) * 100));
        bar.style.width = pct + '%';
      }
      if (heroBg) {
        const y = window.scrollY;
        if (y < 1000) heroBg.style.transform = `scale(1.08) translateY(${y * 0.25}px)`;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const tocLinks = document.querySelectorAll('.toc-link');
    const sections = Array.from(tocLinks).map(a => document.querySelector(a.getAttribute('href')));
    function updateTOC() {
      const y = window.scrollY + 200;
      let activeIdx = 0;
      sections.forEach((sec, i) => { if (sec && sec.offsetTop <= y) activeIdx = i; });
      tocLinks.forEach((l, i) => l.classList.toggle('active', i === activeIdx));
    }
    window.addEventListener('scroll', updateTOC, { passive: true });
    updateTOC();
  </script>
</BaseLayout>
