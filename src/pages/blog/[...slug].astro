  <style>
    /* ============== LAYOUT — CSS-grid driven width tiers ==============
       prose-rf is a grid container. Body content lives in the center
       `body` track (max 720px). Wide elements (figures, philosophy, leaks,
       plays, scoreboard, charts) span the `wide` track. Full-bleed images
       break out of the page entirely via the `full` track. Grid columns
       are computed once in CSS so every element is symmetrically centered
       on the page — no negative-margin breakout hacks. */
    .prose-rf,
    .prose-rf-after {
      display: grid;
      grid-template-columns:
        [full-start] minmax(1.25rem, 1fr)
        [wide-start] minmax(0, 220px)
        [body-start] minmax(0, 720px) [body-end]
        minmax(0, 220px) [wide-end]
        minmax(1.25rem, 1fr) [full-end];
      column-gap: 0;
      row-gap: 0;
    }
    .prose-rf > :global(*),
    .prose-rf-after > :global(*) {
      grid-column: body-start / body-end;
      max-width: 100%;
    }
    .prose-rf > :global(.rf-figure),
    .prose-rf > :global(.rf-philosophy),
    .prose-rf > :global(.rf-leaks),
    .prose-rf > :global(.rf-plays),
    .prose-rf > :global(.rf-scoreboard),
    .prose-rf > :global(.rf-chart),
    .prose-rf > :global(.rf-diagram) {
      grid-column: wide-start / wide-end;
    }
    /* Full-bleed modifier — diagram extends past wide-track to the edge of the
       page. Used when an SVG needs more horizontal room than the wide track
       (e.g., 7+ input nodes converging into a hub + output rate box).
       Hidden on mobile where the SVG would compress to unreadable text — the
       paired rf-leaks grid above already enumerates the same content. */
    .prose-rf > :global(.rf-diagram-full) {
      grid-column: full-start / full-end;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
    @media (min-width: 1280px) {
      .prose-rf > :global(.rf-diagram-full) {
        padding-left: 2rem;
        padding-right: 2rem;
      }
    }
    @media (max-width: 768px) {
      .prose-rf > :global(.rf-diagram-full) {
        display: none;
      }
    }
    /* rf-diagram (custom inline SVGs — flow charts, line charts) */
    .prose-rf :global(.rf-diagram) {
      margin: 3rem 0 4rem;
      padding: 1.5rem 0;
    }
    .prose-rf :global(.rf-diagram > svg) { display: block; width: 100%; height: auto; max-width: 100%; }
    .prose-rf :global(.rf-diagram figcaption) {
      font-family:'Cormorant Garamond',Georgia,serif;
      font-style:italic; font-size: 20px; line-height: 1.45;
      color: #3F261F; text-align: center;
      margin: 1.25rem auto 0; max-width: 820px;
      padding: 0 1.25rem;
    }
    @media (max-width: 768px) {
      .prose-rf :global(.rf-diagram) { margin: 2rem -1rem 3rem; }
      .prose-rf :global(.rf-diagram figcaption) { font-size: 17px; padding: 0 0.75rem; }
    }
    .prose-rf > :global(.rf-bleed) {
      grid-column: full-start / full-end;
      width: 100%;
      margin: 3rem 0;
    }
    .prose-rf-after > :global(.rf-tags),
    .prose-rf-after > :global(.rf-author-card) {
      grid-column: body-start / body-end;
    }
    .prose-rf-after > :global(.rf-tags) {
      margin-top: 0.5rem;
      padding-top: 2rem;
      border-top: 1px solid #C8C4BC;
    }
    .prose-rf-after > :global(.rf-author-card) {
      margin-top: 3rem;
      padding: 2rem;
      background: #E8E6E1;
      border: 1px solid #C8C4BC;
      border-radius: 16px;
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;
      flex-wrap: wrap;
    }
    @media (min-width: 768px) {
      .prose-rf-after > :global(.rf-author-card) { flex-wrap: nowrap; }
    }

    /* Floating-TOC behavior: keep panel narrow, tighten line-height,
       active item gets cedar treatment. Hidden until user scrolls past hero.
       Z-index 20 so full-bleed image sections (z-index 30) cover it cleanly. */
    /* ============== TOC FLOAT — collapsed pill + expand-on-hover panel ==============
       Default: a compact pill showing current section + position (01/11).
       On hover or focus, the pill grows into a full panel listing all sections.
       Active section gets cedar treatment + bumped weight. */
    #tocFloat {
      transform: translateZ(0);
      opacity: 0;
      pointer-events: none;
      transition: opacity 350ms cubic-bezier(0.25,0.1,0.25,1);
      z-index: 20;
    }
    #tocFloat.visible { opacity: 1; pointer-events: auto; }

    /* Collapsed pill — always visible when #tocFloat.visible is set */
    .rf-toc-pill {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      max-width: 280px;
      padding: 10px 14px 10px 16px;
      background: #E8E6E1;
      border: 1px solid #C8C4BC;
      border-radius: 999px;
      cursor: pointer;
      box-shadow: 0 1px 3px rgba(22,25,16,0.06);
      transition: box-shadow 200ms cubic-bezier(0.25,0.1,0.25,1), transform 200ms cubic-bezier(0.25,0.1,0.25,1);
      outline: none;
    }
    .rf-toc-pill:hover, .rf-toc-pill:focus-visible {
      box-shadow: 0 4px 14px rgba(22,25,16,0.12);
      transform: translateY(-1px);
    }
    .rf-toc-pill:focus-visible { box-shadow: 0 0 0 2px #13342D, 0 4px 14px rgba(22,25,16,0.12); }
    .rf-toc-progress {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      height: 2px;
      background: rgba(93,109,89,0.15);
      border-radius: 0 0 999px 999px;
      overflow: hidden;
    }
    .rf-toc-progress > span {
      display: block;
      width: 0%;
      height: 100%;
      background: #5D6D59;
      transition: width 75ms linear;
    }
    .rf-toc-num,
    .rf-toc-total,
    .rf-toc-divider {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.5px;
      color: #3F261F;
    }
    .rf-toc-divider { color: #C8C4BC; margin: 0 -2px; }
    .rf-toc-total { color: #76574C; opacity: 0.7; }
    .rf-toc-current {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 14px;
      color: #13342D;
      letter-spacing: 0.25px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 180px;
    }
    .rf-toc-chevron {
      width: 12px; height: 12px;
      color: #76574C;
      flex-shrink: 0;
      transition: transform 200ms cubic-bezier(0.25,0.1,0.25,1);
    }
    #tocFloat.expanded .rf-toc-chevron { transform: rotate(90deg); }

    /* Expanded panel — appears below pill on hover/focus, scrollable if list is long */
    .rf-toc-panel {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      width: 280px;
      max-height: calc(100vh - 220px);
      overflow-y: auto;
      padding: 1.25rem 1.25rem 1rem;
      background: #E8E6E1;
      border: 1px solid #C8C4BC;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(22,25,16,0.12);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition: opacity 200ms cubic-bezier(0.25,0.1,0.25,1), transform 200ms cubic-bezier(0.25,0.1,0.25,1), visibility 0s linear 200ms;
    }
    #tocFloat.expanded .rf-toc-panel,
    #tocFloat:hover .rf-toc-panel,
    #tocFloat:focus-within .rf-toc-panel {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition: opacity 200ms cubic-bezier(0.25,0.1,0.25,1), transform 200ms cubic-bezier(0.25,0.1,0.25,1), visibility 0s;
    }
    .rf-toc-panel-kicker {
      font-family: Helvetica, Arial, sans-serif;
      font-weight: 700;
      font-size: 9px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #76574C;
      margin: 0 0 0.85rem;
    }
    .rf-toc-panel-list {
      list-style: none;
      margin: 0;
      padding: 0;
      counter-reset: none;
    }
    .rf-toc-panel-list li { margin-bottom: 0.4rem; }
    .rf-toc-panel-list li:last-child { margin-bottom: 0; }
    .rf-toc-panel .toc-link {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      padding: 6px 8px;
      border-radius: 8px;
      text-decoration: none;
