      line-height: 1.65;
      color: #3F261F;
    }

    .toc-link.active { color:#13342D; font-weight:600; }
  </style>

  <script is:inline>
    const bar = document.getElementById('progressBar');
    const article = document.querySelector('article');
    const heroBg = document.getElementById('heroBg');
    const tocFloat = document.getElementById('tocFloat');
    const onScroll = () => {
      if (article && bar) {
        const rect = article.getBoundingClientRect();
        const total = article.offsetHeight - window.innerHeight;
        const scrolled = -rect.top;
        const pct = Math.max(0, Math.min(100, (scrolled / total) * 100));
        bar.style.width = pct + '%';
      }
      if (heroBg) {
        const y = window.scrollY;
        if (y < 1000) heroBg.style.transform = `scale(1.08) translateY(${y * 0.25}px)`;
      }
      // Hide floating TOC during the hero, fade it in once user scrolls past
      if (tocFloat) {
        tocFloat.classList.toggle('visible', window.scrollY > window.innerHeight * 0.7);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Floating TOC pill — track active section, update collapsed-pill label + progress fill
    const tocLinks = document.querySelectorAll('.toc-link');
    const sections = Array.from(tocLinks).map(a => document.querySelector(a.getAttribute('href')));
    const tocCurrentNum = document.getElementById('tocCurrentNum');
    const tocCurrentLabel = document.getElementById('tocCurrentLabel');
    const tocProgressFill = document.getElementById('tocProgressFill');
    function updateTOC() {
      const y = window.scrollY + 200;
      let activeIdx = 0;
      sections.forEach((sec, i) => { if (sec && sec.offsetTop <= y) activeIdx = i; });
      tocLinks.forEach((l, i) => l.classList.toggle('active', i === activeIdx));
      if (tocCurrentNum) tocCurrentNum.textContent = String(activeIdx + 1).padStart(2, '0');
      if (tocCurrentLabel) {
        const activeLink = tocLinks[activeIdx];
        const labelEl = activeLink && activeLink.querySelector('.rf-toc-panel-label');
        if (labelEl) tocCurrentLabel.textContent = labelEl.textContent;
      }
      if (tocProgressFill && sections.length > 0) {
        const pct = ((activeIdx + 1) / sections.length) * 100;
        tocProgressFill.style.width = pct + '%';
      }
    }
    window.addEventListener('scroll', updateTOC, { passive: true });
    updateTOC();

    // Floating TOC pill — click-to-toggle on touch / no-hover devices, auto-close on link
    const tocPill = document.getElementById('tocPill');
    const tocFloatEl = document.getElementById('tocFloat');
    if (tocPill && tocFloatEl) {
      tocPill.addEventListener('click', (e) => {
        e.preventDefault();
        const isExpanded = tocFloatEl.classList.toggle('expanded');
        tocPill.setAttribute('aria-expanded', String(isExpanded));
      });
      tocPill.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          tocPill.click();
        }
        if (e.key === 'Escape') {
          tocFloatEl.classList.remove('expanded');
          tocPill.setAttribute('aria-expanded', 'false');
        }
      });
      tocLinks.forEach(link => {
        link.addEventListener('click', () => {
          tocFloatEl.classList.remove('expanded');
          tocPill.setAttribute('aria-expanded', 'false');
        });
      });
      document.addEventListener('click', (e) => {
        if (!tocFloatEl.contains(e.target)) {
          tocFloatEl.classList.remove('expanded');
          tocPill.setAttribute('aria-expanded', 'false');
        }
      });
    }
  </script>
</BaseLayout>
