    .prose-rf :global(.rf-philosophy) { margin:2rem 0 1.5rem; }
    .prose-rf :global(.rf-philosophy-header) { text-align:center; margin-bottom:1.75rem; }
    .prose-rf :global(.rf-philosophy-header .kicker) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#76574C; margin:0 0 0.75rem; }
    .prose-rf :global(.rf-philosophy-header h3) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-weight:400; font-size:clamp(32px,4vw,48px); color:#13342D; margin:0 0 0.5rem !important; }
    .prose-rf :global(.rf-philosophy-header .lede) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:21px; color:#76574C; margin:0; line-height:1.4; }

    .prose-rf :global(.rf-philosophy-grid) {
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:1.25rem;
      margin-top:1.5rem;
    }
    @media (max-width: 768px) { .prose-rf :global(.rf-philosophy-grid) { grid-template-columns:1fr; } }
    .prose-rf :global(.rf-philosophy-card) {
      border-radius:16px;
      padding:2rem 1.5rem;
      text-align:center;
      color:#DDDAD3;
      min-height: 320px;
      display:flex;
      flex-direction:column;
      justify-content:flex-start;
    }
    .prose-rf :global(.rf-philosophy-card.cedar)   { background:#13342D; }
    .prose-rf :global(.rf-philosophy-card.moss)    { background:#5D6D59; }
    .prose-rf :global(.rf-philosophy-card.tobacco) { background:#3F261F; }
    .prose-rf :global(.rf-philosophy-card .num) { font-family:'JetBrains Mono',monospace; font-weight:500; font-size:56px; line-height:1; margin:0 0 0.5rem; opacity:0.85; }
    .prose-rf :global(.rf-philosophy-card.cedar .num)   { color:#A9BBA3; }
    .prose-rf :global(.rf-philosophy-card.moss .num)    { color:#E8E6E1; }
    .prose-rf :global(.rf-philosophy-card.tobacco .num) { color:#A9BBA3; }
    .prose-rf :global(.rf-philosophy-card .rule) { width:48px; height:1px; background:currentColor; opacity:0.5; margin:0 auto 1rem; }
    .prose-rf :global(.rf-philosophy-card .label) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:13px; letter-spacing:3px; text-transform:uppercase; opacity:1; color:#E8E6E1 !important; margin:0 0 1.25rem !important; }
    .prose-rf :global(.rf-philosophy-card.moss .label) { color:#E8E6E1 !important; }
    .prose-rf :global(.rf-philosophy-card .lead) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-weight:500; font-size:26px; line-height:1.2; margin:0 0 1.25rem !important; color:#E8E6E1 !important; }
    .prose-rf :global(.rf-philosophy-card.moss .lead) { color:#E8E6E1 !important; }
    .prose-rf :global(.rf-philosophy-card .body) { font-family:Helvetica,'Helvetica Neue',Arial,sans-serif; font-size:16px; line-height:1.55; opacity:1; color:#E8E6E1; margin:0 0 0.75rem !important; }
    .prose-rf :global(.rf-philosophy-card.moss .body) { color:#E8E6E1; }
    .prose-rf :global(.rf-philosophy-card .pull) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:17px; opacity:0.9; color:#E8E6E1; margin:auto 0 0 !important; padding-top:1rem; }
    .prose-rf :global(.rf-philosophy-card.moss .pull) { color:#E8E6E1; }
    /* Philosophy cards override the global em → cedar rule so italic text inside cards
       inherits the card's text color (not moss, which goes invisible on moss/cedar bg) */
    .prose-rf :global(.rf-philosophy-card em) { color:inherit !important; font-family:inherit; }

    /* 7 Leaks — 4-up responsive grid on the WIDE track. */
    .prose-rf :global(.rf-leaks) { margin:2rem 0 1.5rem; }
    .prose-rf :global(.rf-leaks-header) { text-align:center; margin-bottom:1.5rem; }
    .prose-rf :global(.rf-leaks-header .kicker) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#76574C; margin:0 0 0.75rem; }
    .prose-rf :global(.rf-leaks-header h3) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:clamp(32px,4vw,48px); color:#13342D; margin:0 0 0.5rem !important; }
    .prose-rf :global(.rf-leaks-header .lede) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:20px; color:#76574C; margin:0; line-height:1.4; }

    .prose-rf :global(.rf-leaks-grid) {
      display:grid;
      grid-template-columns: repeat(4, 1fr);
      gap:1rem;
      margin-top:1.5rem;
    }
    @media (max-width: 1100px) { .prose-rf :global(.rf-leaks-grid) { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 768px)  { .prose-rf :global(.rf-leaks-grid) { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px)  { .prose-rf :global(.rf-leaks-grid) { grid-template-columns: 1fr; } }

    .prose-rf :global(.rf-leak-card) {
      background:#E8E6E1;
      border-radius:12px;
      padding:1.5rem 1.25rem;
      position:relative;
      border-top:4px solid var(--leak-accent, #13342D);
    }
    .prose-rf :global(.rf-leak-card.cedar)   { --leak-accent:#13342D; }
    .prose-rf :global(.rf-leak-card.moss)    { --leak-accent:#5D6D59; }
    .prose-rf :global(.rf-leak-card.tobacco) { --leak-accent:#3F261F; }
    .prose-rf :global(.rf-leak-card.walnut)  { --leak-accent:#76574C; }
    .prose-rf :global(.rf-leak-card .num) { font-family:'JetBrains Mono',monospace; font-weight:500; font-size:42px; line-height:1; margin:0 0 0.65rem !important; color:var(--leak-accent); }
    .prose-rf :global(.rf-leak-card .label) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:10px; letter-spacing:1.8px; text-transform:uppercase; color:#5D6D59; margin:0 0 0.6rem !important; }
    .prose-rf :global(.rf-leak-card .title) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:23px; line-height:1.2; color:#13342D; margin:0 0 0.65rem !important; letter-spacing:0.25px; }
    .prose-rf :global(.rf-leak-card .body) { font-family:Helvetica,'Helvetica Neue',Arial,sans-serif; font-size:14px; line-height:1.6; color:#3F261F; margin:0 !important; }
    /* Override em color inside leak cards so italic doesn't go cedar-on-bone-on-cedar-accent */
    .prose-rf :global(.rf-leak-card em) { color:#13342D; }

    /* ============== RF-SCOREBOARD — RevPAR vs ADR comparison cards ============== */
    .prose-rf :global(.rf-scoreboard) { margin:2rem 0 1.5rem; }
    .prose-rf :global(.rf-scoreboard-header) { text-align:center; margin-bottom:2rem; }
    .prose-rf :global(.rf-scoreboard-header .kicker) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#76574C; margin:0 0 0.75rem; }
    .prose-rf :global(.rf-scoreboard-header h3) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:clamp(34px,4.5vw,52px); color:#13342D; margin:0 0 0.5rem !important; letter-spacing:0.25px; }
    .prose-rf :global(.rf-scoreboard-header .lede) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:20px; color:#76574C; margin:0; line-height:1.4; }

    .prose-rf :global(.rf-scoreboard-grid) {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      margin-top: 1.5rem;
    }
    @media (max-width: 768px) { .prose-rf :global(.rf-scoreboard-grid) { grid-template-columns: 1fr; } }

    .prose-rf :global(.rf-score-card) {
      border-radius: 16px;
      padding: 2rem;
      border: 1px solid #C8C4BC;
    }
    .prose-rf :global(.rf-score-card.bone)  { background: #E8E6E1; }
    .prose-rf :global(.rf-score-card.cedar) { background: #13342D; border-color: #13342D; color: #E8E6E1; }
    .prose-rf :global(.rf-score-card .label) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:10px; letter-spacing:2.5px; text-transform:uppercase; opacity:0.7; margin:0 0 1rem !important; }
    .prose-rf :global(.rf-score-card .lede)  { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:22px; line-height:1.3; margin:0 0 1.5rem !important; }
    .prose-rf :global(.rf-score-card.bone .lede)  { color: #76574C; }
    .prose-rf :global(.rf-score-card.cedar .lede) { color: #DDDAD3; }
    .prose-rf :global(.rf-score-row) {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--score-border, #C8C4BC);
    }
    .prose-rf :global(.rf-score-card.cedar .rf-score-row) { --score-border: rgba(221,218,211,0.18); }
    .prose-rf :global(.rf-score-row:last-child) { border-bottom: none; }
    .prose-rf :global(.rf-score-row .key) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:10px; letter-spacing:2px; text-transform:uppercase; opacity:0.7; }
    .prose-rf :global(.rf-score-row .val) { font-family:'JetBrains Mono',monospace; font-weight:500; font-size:22px; }
    .prose-rf :global(.rf-score-row.hero .key) { opacity: 1; }
    .prose-rf :global(.rf-score-row.hero .val) { font-size: 32px; }
    .prose-rf :global(.rf-score-card.cedar .rf-score-row.hero .val) { color: #A9BBA3; }
    .prose-rf :global(.rf-score-card.bone .rf-score-row.hero .val) { color: #13342D; }
    .prose-rf :global(.rf-score-delta) {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.25rem;
      margin-top: 1.25rem;
      padding: 1.1rem 1.75rem;
      background: #3F261F;
      color: #E8E6E1;
      border-radius: 999px;
      flex-wrap: wrap;
      row-gap: 0.4rem;
      line-height: 1.25;
    }
    .prose-rf :global(.rf-score-delta .lbl) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:10px; letter-spacing:2px; text-transform:uppercase; color: #A9BBA3; line-height:1; }
    .prose-rf :global(.rf-score-delta .copy) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:18px; flex:1 1 auto; min-width:0; line-height:1.25; }
    .prose-rf :global(.rf-score-delta .val) { font-family:'JetBrains Mono',monospace; font-weight:500; font-size:22px; color: #E8E6E1; line-height:1; }

    /* ============== RF-PLAYS — 6 tactical plays grid ============== */
    .prose-rf :global(.rf-plays) {
      margin: 2rem 0 1.5rem;
      background: #13342D;
      border-radius: 24px;
      padding: 3rem 2rem;
    }
    .prose-rf :global(.rf-plays-header) { text-align:center; margin-bottom:2.25rem; }
    .prose-rf :global(.rf-plays-header .kicker) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#7A8B76; margin:0 0 0.75rem; }
    .prose-rf :global(.rf-plays-header h3) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:clamp(34px,4.5vw,56px); color:#E8E6E1; margin:0 0 0.5rem !important; letter-spacing:0.25px; }
    .prose-rf :global(.rf-plays-header .lede) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:20px; color:#A9BBA3; margin:0; line-height:1.4; }

    .prose-rf :global(.rf-plays-grid) {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      margin-top: 2rem;
    }
    @media (max-width: 1024px) { .prose-rf :global(.rf-plays-grid) { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px)  { .prose-rf :global(.rf-plays-grid) { grid-template-columns: 1fr; } }

    .prose-rf :global(.rf-play-card) {
      background: #E8E6E1;
      border-radius: 16px;
      padding: 2rem 1.75rem;
      min-height: 280px;
      display: flex;
      flex-direction: column;
    }
    .prose-rf :global(.rf-play-card .num) { font-family:'JetBrains Mono',monospace; font-weight:500; font-size:13px; letter-spacing:3px; color:#5D6D59; text-transform:uppercase; margin:0 0 1rem !important; }
    .prose-rf :global(.rf-play-card .name) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:28px; line-height:1.15; color:#13342D; margin:0 0 1rem !important; letter-spacing:0.25px; }
    .prose-rf :global(.rf-play-card .copy) { font-family:Helvetica,'Helvetica Neue',Arial,sans-serif; font-size:15px; line-height:1.65; color:#3F261F; margin:0 !important; }
    .prose-rf :global(.rf-play-card em) { color:#13342D; }

    /* ============== RF-BLEED — full-bleed image with quote overlay ============== */
    .prose-rf :global(.rf-bleed) {
      position: relative;
      min-height: 480px;
      overflow: hidden;
      display: flex;
      align-items: center;
      isolation: isolate;
      z-index: 30;  /* Above the floating TOC (z-20) so the image always wins on scroll */
      margin: 2rem 0 1.5rem;
    }
    .prose-rf :global(.rf-bleed img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }
    .prose-rf :global(.rf-bleed::after) {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(22,25,16,0.85) 0%, rgba(22,25,16,0.55) 50%, rgba(22,25,16,0.3) 100%);
      z-index: 1;
    }
    .prose-rf :global(.rf-bleed-inner) {
      position: relative;
      z-index: 2;
      max-width: 720px;
      padding: 4rem 1.5rem;
      margin: 0 auto;
      width: 100%;
    }
    @media (min-width: 768px) { .prose-rf :global(.rf-bleed-inner) { padding: 5rem 3rem; } }
    .prose-rf :global(.rf-bleed blockquote) {
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
      background: transparent !important;
    }
    .prose-rf :global(.rf-bleed blockquote p) {
      font-family:'Cormorant Garamond',Georgia,serif;
      font-style: italic;
      font-weight: 400;
      font-size: clamp(28px, 3.6vw, 44px);
      line-height: 1.2;
      color: #E8E6E1 !important;
      margin: 0 0 1.25rem !important;
    }
    .prose-rf :global(.rf-bleed cite) {
      font-family:Helvetica,Arial,sans-serif;
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #A9BBA3;
      font-style: normal;
    }

    /* ============== RF-CHART — pure-CSS horizontal bar chart ============== */
    .prose-rf :global(.rf-chart) {
      margin: 3rem 0;
      padding: 2.25rem;
      background: #E8E6E1;
      border-radius: 20px;
      border: 1px solid #C8C4BC;
    }
    .prose-rf :global(.rf-chart-header) { margin-bottom: 1.75rem; }
    .prose-rf :global(.rf-chart-header .kicker) { font-family:Helvetica,Arial,sans-serif; font-weight:700; font-size:10px; letter-spacing:2.5px; text-transform:uppercase; color:#76574C; margin:0 0 0.5rem; }
    .prose-rf :global(.rf-chart-header h3) { font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:clamp(26px,3vw,36px); color:#13342D; margin:0 0 0.4rem !important; letter-spacing:0.25px; }
    .prose-rf :global(.rf-chart-header .lede) { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:17px; color:#76574C; margin:0; line-height:1.4; }
    .prose-rf :global(.rf-chart-rows) {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-top: 1.5rem;
    }
    .prose-rf :global(.rf-chart-row) {
      display: grid;
      grid-template-columns: 110px 1fr 90px;
      align-items: center;
      gap: 1rem;
    }
    @media (max-width: 640px) {
      .prose-rf :global(.rf-chart-row) { grid-template-columns: 70px 1fr 70px; }
    }
    .prose-rf :global(.rf-chart-label) {
      font-family:'Cormorant Garamond',Georgia,serif;
      font-weight: 500;
      font-size: 17px;
      color: #3F261F;
      letter-spacing: 0.25px;
    }
    .prose-rf :global(.rf-chart-bar) {
      position: relative;
      height: 32px;
      background: rgba(118,87,76,0.12);
      border-radius: 6px;
      overflow: hidden;
    }
    .prose-rf :global(.rf-chart-fill) {
      position: absolute;
      left: 0; top: 0; bottom: 0;
      background: linear-gradient(90deg, #13342D 0%, #1E4A40 100%);
      border-radius: 6px;
      transition: width 600ms cubic-bezier(0.25,0.1,0.25,1);
    }
    .prose-rf :global(.rf-chart-fill.comp) {
      background: linear-gradient(90deg, #76574C 0%, #8F6E62 100%);
    }
    .prose-rf :global(.rf-chart-value) {
      font-family:'JetBrains Mono',monospace;
      font-weight: 500;
      font-size: 16px;
      color: #13342D;
      text-align: right;
    }
    .prose-rf :global(.rf-chart-legend) {
      display: flex;
      gap: 1.5rem;
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid #C8C4BC;
      flex-wrap: wrap;
    }
    .prose-rf :global(.rf-chart-legend > span) {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family:Helvetica,Arial,sans-serif;
      font-weight: 700;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #76574C;
    }
    .prose-rf :global(.rf-chart-legend .swatch) {
      width: 14px; height: 14px; border-radius: 3px; display: inline-block;
    }
    .prose-rf :global(.rf-chart-legend .swatch.cedar) { background: #13342D; }
    .prose-rf :global(.rf-chart-legend .swatch.walnut) { background: #76574C; }

    /* ============== RF-BAND — colored-section breaks for contrast ==============
       Full-bleed band on the WIDE grid track (not full viewport — keeps a
       margin so it reads as a callout, not a hero). Variants: cedar, tobacco, moss.
       Place inline in MDX wherever a content beat deserves emphasis. */
    .prose-rf :global(.rf-band) { margin:2rem 0 1.5rem;
      margin: 3rem 0;
      padding: 2.5rem 2.25rem;
      border-radius: 20px;
      position: relative;
    }
    @media (min-width: 768px) { .prose-rf :global(.rf-band) { padding: 3rem 3rem; } }
    .prose-rf :global(.rf-band.cedar)   { background: #13342D; color: #DDDAD3; }
    .prose-rf :global(.rf-band.tobacco) { background: #3F261F; color: #DDDAD3; }
    .prose-rf :global(.rf-band.moss)    { background: #5D6D59; color: #E8E6E1; }
    .prose-rf :global(.rf-band.bone)    { background: #E8E6E1; color: #3F261F; border: 1px solid #C8C4BC; }

    .prose-rf :global(.rf-band .kicker) {
      font-family: Helvetica, Arial, sans-serif;
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #7A8B76;
      margin: 0 0 1rem !important;
    }
    .prose-rf :global(.rf-band.tobacco .kicker) { color: #A9BBA3; }
    .prose-rf :global(.rf-band.moss .kicker)    { color: #13342D; }
    .prose-rf :global(.rf-band.bone .kicker)    { color: #76574C; }

    .prose-rf :global(.rf-band h3) {
      font-family: 'Cormorant Garamond', Georgia, serif !important;
      font-weight: 500 !important;
      font-size: clamp(28px, 3.4vw, 40px) !important;
      line-height: 1.15 !important;
      color: inherit !important;
      margin: 0 0 1rem !important;
      letter-spacing: 0.25px !important;
    }
    .prose-rf :global(.rf-band p) {
      font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif !important;
      font-size: 17px !important;
      line-height: 1.65 !important;
      color: inherit !important;
      opacity: 0.92;
      margin: 0 0 1em !important;
    }
    .prose-rf :global(.rf-band p:last-child) { margin-bottom: 0 !important; }
    .prose-rf :global(.rf-band em) {
      font-family: 'Cormorant Garamond', Georgia, serif !important;
      color: inherit !important;
      font-style: italic;
      opacity: 1;
    }
    .prose-rf :global(.rf-band strong) { color: inherit !important; opacity: 1; }

    /* RF-CTA-BAND — the post-closing CTA that bridges into the author bio.
       Uses cedar background to draw the eye without competing with the article body. */
    .prose-rf :global(.rf-cta-band) {
      margin: 3rem 0 2.5rem;
      padding: 2.25rem 2rem;
      background: #13342D;
      color: #E8E6E1;
      border-radius: 20px;
      text-align: center;
    }
    @media (min-width: 768px) {
      .prose-rf :global(.rf-cta-band) { padding: 2.75rem 3rem; }
    }
    .prose-rf :global(.rf-cta-band .kicker) {
      font-family: 'Cormorant Garamond', Georgia, serif !important;
      font-style: italic;
      font-weight: 400 !important;
      font-size: clamp(22px, 2.4vw, 28px) !important;
      line-height: 1.3 !important;
      color: #E8E6E1 !important;
      margin: 0 0 1rem !important;
      text-transform: none !important;
      letter-spacing: 0 !important;
    }
    .prose-rf :global(.rf-cta-band p) {
      font-family: Helvetica, Arial, sans-serif !important;
