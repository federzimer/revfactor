---
// Single-post template — Layout 1 (Classic / Field Report)
// Ported from src/pages/blog-mockups/post-classic.astro into a content-collection-driven template.
// Source design: feature/journal branch.

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.jsx';
import Footer from '../../components/Footer.jsx';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
const updatedDate = post.data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});

// TOC: H2 headings only (Astro auto-generates anchor slugs)
const toc = headings.filter((h) => h.depth === 2).map((h) => ({
  href: `#${h.slug}`,
  label: h.text,
}));

// Related posts: prefer same category, fall back to recency
const otherPosts = allPosts.filter((p) => p.id !== post.id);
const sameCategory = otherPosts.filter((p) => p.data.category === post.data.category);
const relatedSource = [...sameCategory, ...otherPosts.filter((p) => p.data.category !== post.data.category)];
const related = relatedSource.slice(0, 3).map((p) => ({
  href: `/blog/${p.id}`,
  cat: p.data.category,
  date: p.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
  read: p.data.readingTime ? `${p.data.readingTime} min` : '8 min',
  title: p.data.title,
  img: p.data.image || 'https://images.unsplash.com/photo-1502784444187-359ac186c5bb?auto=format&fit=crop&w=1000&q=80',
}));

const heroImage = post.data.image || 'https://images.unsplash.com/photo-1502784444187-359ac186c5bb?auto=format&fit=crop&w=2400&q=85';
const heroAlt = post.data.imageAlt || post.data.title;

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": heroImage.startsWith('http') ? heroImage : `https://revfactor.io${heroImage}`,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": "https://revfactor.io/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "RevFactor",
    "url": "https://revfactor.io",
    "logo": {
      "@type": "ImageObject",
      "url": "https://revfactor.io/og-image.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  },
  "keywords": post.data.tags.join(', '),
  "articleSection": post.data.category
};
---

<BaseLayout
  title={`${post.data.title} — The Curve`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  author={post.data.author}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <Navbar client:load lightBg />

  <!-- Read progress bar -->
  <div id="progressBar" class="fixed top-0 left-0 h-[3px] bg-[#13342D] z-[100] transition-[width] duration-75" style="width:0;"></div>

  <article>
    <!-- HERO — centered title above full-width image -->
    <div class="max-w-5xl mx-auto px-6 md:px-12 pt-36 md:pt-44 pb-12 text-center">
      <span class="font-bold uppercase text-[9px] tracking-[3px] text-[#5D6D59] mb-8 inline-block">
        {post.data.category} · Field Report
      </span>
      <h1
        class="text-[#3F261F] mb-6 mx-auto"
        style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:clamp(40px,5.5vw,76px); line-height:1.05; max-width:980px; letter-spacing:-0.5px;"
      >
        {post.data.title}
      </h1>
      <p
        class="text-[#76574C] max-w-3xl mx-auto mb-12"
        style="font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-weight:300; font-size:clamp(19px,2vw,24px); line-height:1.4;"
      >
        {post.data.description}
      </p>
      <div class="flex items-center justify-center gap-8 flex-wrap py-6 border-y border-[#C8C4BC] max-w-3xl mx-auto mb-12">
        <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#8F6E62; letter-spacing:0.5px; text-transform:uppercase;">
          <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#3F261F] mb-1" style="font-family:inherit;">Published</div>
          <div>{formattedDate}</div>
        </div>
        {post.data.readingTime && (
          <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#8F6E62; letter-spacing:0.5px; text-transform:uppercase;">
            <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#3F261F] mb-1" style="font-family:inherit;">Read time</div>
            <div>{post.data.readingTime} minutes</div>
          </div>
        )}
        <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#8F6E62; letter-spacing:0.5px; text-transform:uppercase;">
          <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#3F261F] mb-1" style="font-family:inherit;">Author</div>
          <div>{post.data.author}</div>
        </div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#8F6E62; letter-spacing:0.5px; text-transform:uppercase;">
          <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#3F261F] mb-1" style="font-family:inherit;">Category</div>
          <div>{post.data.category}</div>
        </div>
        {updatedDate && (
          <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#8F6E62; letter-spacing:0.5px; text-transform:uppercase;">
            <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#3F261F] mb-1" style="font-family:inherit;">Updated</div>
            <div>{updatedDate}</div>
          </div>
        )}
      </div>
    </div>

    <!-- HERO IMAGE -->
    <div class="max-w-6xl mx-auto px-6 md:px-12 mb-16">
      <div class="rounded-[24px] overflow-hidden" style="aspect-ratio:21/9;">
        <img src={heroImage} alt={heroAlt} class="w-full h-full object-cover" />
      </div>
    </div>

    <!-- BODY + TOC -->
    <div class="max-w-6xl mx-auto px-6 md:px-12 grid md:grid-cols-[1fr_240px] gap-16 md:gap-20 pb-24">
      <div class="max-w-2xl min-w-0">

        <!-- Byline bar -->
        <div class="flex items-center justify-between gap-6 mb-12 pb-8 border-b border-[#C8C4BC] flex-wrap">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-[#13342D] flex items-center justify-center text-[#E8E6E1] font-bold text-[13px]" style="font-family:'Cormorant Garamond',Georgia,serif;">FZ</div>
            <div>
              <div class="text-[18px] text-[#3F261F] leading-tight" style="font-family:'Cormorant Garamond',Georgia,serif;">{post.data.author.toLowerCase()}</div>
              <div class="font-bold uppercase text-[9px] tracking-[2px] text-[#8F6E62]">Founder · RevFactor</div>
            </div>
          </div>
          <div class="flex gap-2">
            <button id="shareBtn" class="px-3 py-1.5 rounded-full border border-[#C8C4BC] text-[11px] font-bold uppercase tracking-[1.5px] text-[#3F261F] hover:border-[#3F261F] transition-colors">Share</button>
            <button id="saveBtn" class="px-3 py-1.5 rounded-full border border-[#C8C4BC] text-[11px] font-bold uppercase tracking-[1.5px] text-[#3F261F] hover:border-[#3F261F] transition-colors">Save</button>
          </div>
        </div>

        <div class="prose-rf">
          <Content />
        </div>

        {post.data.tags.length > 0 && (
          <div class="mt-16 pt-8 border-t border-[#C8C4BC]">
            <p class="font-bold uppercase text-[9px] tracking-[2.5px] text-[#8F6E62] mb-3">Topics</p>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="px-3 py-1 bg-[#E8E6E1] text-[#76574C] text-[12px] rounded-full border border-[#C8C4BC]">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Author card -->
        <div class="mt-16 p-8 rounded-[16px] bg-[#E8E6E1] border border-[#C8C4BC] flex gap-6 items-start flex-wrap md:flex-nowrap">
          <div class="w-16 h-16 rounded-full bg-[#13342D] flex items-center justify-center text-[#E8E6E1] font-bold text-[18px] flex-shrink-0" style="font-family:'Cormorant Garamond',Georgia,serif;">FZ</div>
          <div>
            <h4 class="text-[22px] text-[#3F261F] mb-1" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;">{post.data.author.toLowerCase()}</h4>
            <div class="font-bold uppercase text-[9px] tracking-[2px] text-[#8F6E62] mb-4">Founder · RevFactor</div>
            <p class="text-[14px] leading-[1.6] text-[#76574C] mb-4">Federico spent 10 years in airline revenue management at American Airlines before applying those principles to short-term rentals. RevFactor's pricing strategies are battle-tested across 165+ properties in 24 states. He writes the Thursday dispatch.</p>
            <div class="flex gap-2 flex-wrap">
              <a href="https://www.linkedin.com/in/federico-zimerman-23ab3345/" target="_blank" rel="noopener" class="px-3 py-1.5 rounded-full border border-[#C8C4BC] text-[11px] font-bold uppercase tracking-[1.5px] text-[#3F261F] hover:border-[#3F261F] transition-colors">Follow on LinkedIn</a>
              <a href="/journal" class="px-3 py-1.5 rounded-full border border-[#C8C4BC] text-[11px] font-bold uppercase tracking-[1.5px] text-[#3F261F] hover:border-[#3F261F] transition-colors">More essays</a>
            </div>
          </div>
        </div>
      </div>

      <!-- TOC (sticky) -->
      <aside class="md:sticky md:top-24 md:self-start md:pl-6 md:border-l border-[#C8C4BC]">
        <h5 class="font-bold uppercase text-[9px] tracking-[2.5px] text-[#8F6E62] mb-4">In this essay</h5>
        <ul class="space-y-2.5" id="toc">
          {toc.map((item, i) => (
            <li>
              <a href={item.href} class="toc-link flex items-baseline gap-2 text-[13px] leading-[1.4] text-[#76574C] hover:text-[#13342D] transition-colors">
                <span class="flex-shrink-0 text-[#C8C4BC] tabular-nums" style="font-family:'JetBrains Mono',monospace; min-width:22px;">{String(i + 1).padStart(2, '0')}</span>
                <span class="block">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="max-w-7xl mx-auto px-6 md:px-12 pb-24">
        <div class="flex items-end justify-between mb-10 flex-wrap gap-4">
          <div>
            <span class="font-bold uppercase text-[9px] tracking-[3px] text-[#8F6E62] mb-2 block">Keep reading</span>
            <h2 class="text-[#3F261F]" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:clamp(28px,3.5vw,40px);">More <em style="font-style:italic; color:#7A8B76;">from The Curve.</em></h2>
          </div>
          <a href="/journal" class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[2px] text-[#3F261F] hover:text-[#13342D] transition-colors">
            All field notes
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {related.map((p) => (
            <a href={p.href} class="group block">
              <div class="relative overflow-hidden rounded-[12px] mb-4" style="aspect-ratio:4/3;">
                <span class="absolute top-3 left-3 z-[2] px-2.5 py-1 rounded-full bg-[#E8E6E1]/92 text-[#3F261F] font-bold uppercase text-[9px] tracking-[2px] backdrop-blur-sm">{p.cat}</span>
                <img src={p.img} alt="" class="w-full h-full object-cover transition-transform duration-[600ms] group-hover:scale-[1.04]"/>
              </div>
              <div class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[1.5px] text-[#8F6E62] mb-2">
                <span>{p.date}</span><span>·</span><span>{p.read}</span>
              </div>
              <h3 class="text-[20px] leading-[1.15] text-[#3F261F] group-hover:text-[#13342D] transition-colors" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;">{p.title}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="max-w-7xl mx-auto px-6 md:px-12 pb-24">
      <div class="p-10 md:p-16 bg-[#13342D] rounded-[24px] text-center">
        <p class="font-bold uppercase text-[9px] tracking-[3px] text-[#7A8B76] mb-4">Ready to optimize your revenue?</p>
        <h2
          class="text-[clamp(28px,4vw,42px)] leading-[1.15] text-[#E8E6E1] mb-5 mx-auto max-w-2xl"
          style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400;"
        >
          Let's talk about your <em style="font-style: italic; color: #7A8B76;">properties.</em>
        </h2>
        <p class="text-[15px] leading-[1.7] text-[#CCC8BF] mb-8 max-w-md mx-auto">
          Schedule a free 30-minute discovery call to see what expert revenue management could do for your STR portfolio.
        </p>
        <a href="/review" class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#E8E6E1] text-[#13342D] font-bold uppercase text-[10px] tracking-[2px] rounded-full hover:bg-white transition-colors duration-200">
          Schedule a strategy call →
        </a>
      </div>
    </section>
  </article>

  <Footer client:load />

  <style>
    .prose-rf :global(p) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 19px;
      line-height: 1.65;
      color: #3F261F;
      margin: 0 0 1.5em;
    }
    .prose-rf :global(h2) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 400;
      font-size: clamp(28px, 3.5vw, 40px);
      line-height: 1.15;
      color: #3F261F;
      margin: 2.5em 0 0.75em;
      letter-spacing: -0.25px;
    }
    .prose-rf :global(h3) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 400;
      font-size: clamp(22px, 2.5vw, 28px);
      line-height: 1.2;
      color: #3F261F;
      margin: 2em 0 0.5em;
    }
    .prose-rf :global(ol),
    .prose-rf :global(ul) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 18px;
      line-height: 1.65;
      color: #3F261F;
      padding-left: 1.5em;
      margin: 0 0 1.5em;
    }
    .prose-rf :global(ol) { list-style: decimal; }
    .prose-rf :global(ul) { list-style: disc; }
    .prose-rf :global(li) { margin-bottom: 0.6em; }
    .prose-rf :global(li::marker) { color: #5D6D59; }

    .prose-rf :global(strong) { color: #13342D; font-weight: 600; }
    .prose-rf :global(em)     { color: #5D6D59; font-style: italic; }
    .prose-rf :global(a)      { color: #13342D; text-decoration: underline; text-underline-offset: 3px; }
    .prose-rf :global(a:hover){ color: #1E4A40; }
    .prose-rf :global(hr)     { border: none; border-top: 1px solid #C8C4BC; margin: 2.5rem 0; }

    /* Drop cap on the very first paragraph after the byline bar */
    .prose-rf > :global(p:first-of-type::first-letter) {
      float: left;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 72px;
      line-height: 0.9;
      margin-right: 12px;
      margin-top: 6px;
      color: #13342D;
    }

    .prose-rf :global(blockquote) {
      border-left: 4px solid #13342D;
      padding: 0.5rem 0 0.5rem 1.5rem;
      margin: 2.5rem 0;
      background: transparent;
    }
    .prose-rf :global(blockquote p) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-weight: 300;
      font-size: clamp(22px, 2.6vw, 30px);
      line-height: 1.25;
      color: #3F261F;
      margin: 0;
    }

    .prose-rf :global(code) {
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      background: #C8C4BC;
      color: #13342D;
      padding: 0.15em 0.45em;
      border-radius: 4px;
    }

    .prose-rf :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
      font-size: 14px;
    }
    .prose-rf :global(table thead) { border-bottom: 2px solid #3F261F; }
    .prose-rf :global(table th) {
      text-align: left;
      padding: 12px 14px;
      font-family: Helvetica, Arial, sans-serif;
      font-weight: 700;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #3F261F;
    }
    .prose-rf :global(table td) {
      padding: 14px;
      font-family: 'JetBrains Mono', monospace;
      color: #3F261F;
      border-bottom: 1px solid #C8C4BC;
    }
    .prose-rf :global(table td:first-child) {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
    .prose-rf :global(table tr:last-child td) { border-bottom: none; }
    .prose-rf :global(table strong) { color: #13342D; }

    .prose-rf :global(.rf-figure) {
      margin: 2.5rem -1rem;
      text-align: center;
    }
    .prose-rf :global(.rf-figure img) {
      width: 100%;
      height: auto;
      border-radius: 16px;
      display: block;
    }
    .prose-rf :global(.rf-figure figcaption) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 14px;
      color: #8F6E62;
      margin-top: 0.85rem;
      padding: 0 1.5rem;
    }

    .prose-rf :global(.rf-quick-answer) {
      background: #13342D;
      color: #E8E6E1;
      border-radius: 16px;
      padding: 2rem 2.25rem;
      margin: 2.5rem 0;
    }
    .prose-rf :global(.rf-quick-answer .kicker) {
      font-family: Helvetica, Arial, sans-serif;
      font-weight: 700;
      font-size: 9px;
      letter-spacing: 2.5px;
      color: #7A8B76;
      margin: 0 0 0.85rem;
    }
    .prose-rf :global(.rf-quick-answer p:last-child) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      color: #E8E6E1;
      font-size: 19px;
      line-height: 1.5;
      margin: 0;
    }

    .prose-rf :global(.rf-key-stats) {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin: 2.5rem 0;
      padding: 1.5rem;
      background: rgba(93, 109, 89, 0.08);
      border: 1px solid rgba(93, 109, 89, 0.2);
      border-radius: 16px;
    }
    @media (max-width: 640px) {
      .prose-rf :global(.rf-key-stats) { grid-template-columns: 1fr; }
    }
    .prose-rf :global(.rf-key-stats .label) {
      font-family: Helvetica, Arial, sans-serif;
      font-weight: 700;
      font-size: 8.5px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #5D6D59;
      margin: 0 0 0.4rem;
      text-align: center;
    }
    .prose-rf :global(.rf-key-stats .number) {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 500;
      font-size: clamp(22px, 3vw, 32px);
      color: #13342D;
      margin: 0 0 0.25rem;
      text-align: center;
      line-height: 1;
    }
    .prose-rf :global(.rf-key-stats .caption) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 13px;
      color: #76574C;
      margin: 0;
      text-align: center;
    }

    .prose-rf :global(.rf-takeaways) {
      background: rgba(93, 109, 89, 0.05);
      border: 1px solid #C8C4BC;
      border-radius: 16px;
      padding: 1.75rem 2rem;
      margin: 2.5rem 0;
    }
    .prose-rf :global(.rf-takeaways h3) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 400;
      font-size: 26px;
      color: #13342D;
      margin: 0 0 1rem !important;
      letter-spacing: -0.25px;
    }
    .prose-rf :global(.rf-takeaways ul) {
      margin: 0;
      padding-left: 1.25rem;
      font-size: 16px;
    }
    .prose-rf :global(.rf-takeaways li) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      line-height: 1.5;
      color: #3F261F;
      margin-bottom: 0.6rem;
    }

    .prose-rf :global(.rf-author-bio) {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 1.5rem;
      margin: 3rem 0 1.5rem;
      padding: 1.75rem;
      background: #E8E6E1;
      border-radius: 16px;
      border: 1px solid #C8C4BC;
    }
    @media (max-width: 640px) {
      .prose-rf :global(.rf-author-bio) {
        grid-template-columns: 1fr;
        text-align: center;
      }
    }
    .prose-rf :global(.rf-author-photo) {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
    }
    @media (max-width: 640px) {
      .prose-rf :global(.rf-author-photo) { margin: 0 auto; }
    }
    .prose-rf :global(.rf-author-label) {
      font-family: Helvetica, Arial, sans-serif;
      font-weight: 700;
      font-size: 9px;
      letter-spacing: 2.5px;
      color: #8F6E62;
      margin: 0 0 0.5rem !important;
    }
    .prose-rf :global(.rf-author-content h3) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 400;
      font-size: 28px !important;
      color: #13342D;
      margin: 0 0 0.5rem !important;
    }
    .prose-rf :global(.rf-author-content p) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 16px;
      color: #3F261F;
      line-height: 1.5;
      margin-bottom: 0.85rem;
    }

    /* Layout 1 has its own hero block — hide the MDX rf-hero so we don't double up */
    .prose-rf :global(.rf-hero) { display: none; }

    .toc-link.active {
      color: #13342D;
      font-weight: 600;
    }
  </style>

  <script is:inline>
    const bar = document.getElementById('progressBar');
    const article = document.querySelector('article');
    const onScroll = () => {
      if (!article || !bar) return;
      const rect = article.getBoundingClientRect();
      const total = article.offsetHeight - window.innerHeight;
      const scrolled = -rect.top;
      const pct = Math.max(0, Math.min(100, (scrolled / total) * 100));
      bar.style.width = pct + '%';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const tocLinks = document.querySelectorAll('.toc-link');
    const sections = Array.from(tocLinks).map(a => document.querySelector(a.getAttribute('href')));
    function updateTOC() {
      const y = window.scrollY + 200;
      let activeIdx = 0;
      sections.forEach((sec, i) => { if (sec && sec.offsetTop <= y) activeIdx = i; });
      tocLinks.forEach((l, i) => l.classList.toggle('active', i === activeIdx));
    }
    window.addEventListener('scroll', updateTOC, { passive: true });
    updateTOC();

    const shareBtn = document.getElementById('shareBtn');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        const url = window.location.href;
        const title = document.title;
        if (navigator.share) {
          try { await navigator.share({ title, url }); } catch (_) {}
        } else if (navigator.clipboard) {
          await navigator.clipboard.writeText(url);
          shareBtn.textContent = 'Copied';
          setTimeout(() => { shareBtn.textContent = 'Share'; }, 1500);
        }
      });
    }
  </script>
</BaseLayout>
