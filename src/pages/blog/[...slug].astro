    /* Italics — Cormorant serif in cedar (darker green) per Aaron */
    /* Italic body copy — Cormorant italic optically reads ~10% smaller than the
       Helvetica it's embedded in. Bump 1.08× so an italicized phrase visually
       matches the body weight instead of looking shrunk + bold. */
    /* Cormorant italic reads visually ~15% smaller than Helvetica at the same em.
       Bump to 1.22× (was 1.08×) so inline italicized quotes inside body
       paragraphs match the surrounding text weight instead of looking shrunk. */
    .prose-rf :global(em)     { font-family:'Cormorant Garamond',Georgia,serif; color:#13342D; font-style:italic; font-size:1.22em; line-height:1.4; }
    .prose-rf :global(a)      { color:#13342D; text-decoration:underline; text-underline-offset:3px; }
