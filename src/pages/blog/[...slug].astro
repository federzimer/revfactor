---
// Single-post template — Layout 2 (Immersive)
// Ported from src/pages/blog-mockups/post-immersive.astro into a content-collection-driven template.
// Hero headline reduced from clamp(56px,9vw,140px) to clamp(34px,4.5vw,56px) so it reads at journal scale.

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.jsx';
import Footer from '../../components/Footer.jsx';
import BlogScheduleCTA from '../../components/BlogScheduleCTA.jsx';

// Federico author headshot — used in hero metadata + bottom author card
const FEDE_PHOTO = '/blog/revenue-management-for-short-term-rentals/federico-author.jpg';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});

const toc = headings.filter((h) => h.depth === 2).map((h) => ({
  href: `#${h.slug}`,
  label: h.text,
}));

const otherPosts = allPosts.filter((p) => p.id !== post.id);
const sameCategory = otherPosts.filter((p) => p.data.category === post.data.category);
const relatedSource = [...sameCategory, ...otherPosts.filter((p) => p.data.category !== post.data.category)];
const related = relatedSource.slice(0, 3).map((p) => ({
  href: `/blog/${p.id}`,
  cat: p.data.category,
  date: p.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
  read: p.data.readingTime ? `${p.data.readingTime} min` : '8 min',
  title: p.data.title,
  img: p.data.image || 'https://images.unsplash.com/photo-1502784444187-359ac186c5bb?auto=format&fit=crop&w=1000&q=80',
}));

const heroImage = post.data.image || '/heroes/aframe-1920.webp';
const heroAlt = post.data.imageAlt || post.data.title;

// Federico Person schema — reusable; sameAs locks the entity for AI engines (Refactor.ai disambiguation)
const federicoPerson = {
  "@type": "Person",
  "@id": "https://revfactor.io/#federico",
  "name": "Federico Zimerman",
  "givenName": "Federico",
  "familyName": "Zimerman",
  "jobTitle": "Founder, RevFactor; Founder, Blackbird Hospitality",
  "url": "https://revfactor.io/about",
  "image": `https://revfactor.io${FEDE_PHOTO}`,
  "sameAs": [
    "https://www.tiktok.com/@federicozimerman",
    "https://www.instagram.com/federico.zimerman",
    "https://www.linkedin.com/in/federico-zimerman-23ab3345/"
  ],
  "knowsAbout": [
    "Revenue management",
    "Short-term rental pricing",
    "Airline yield management",
    "RevPAR optimization",
    "Dynamic pricing",
    "PriceLabs"
  ],
  "alumniOf": { "@type": "Organization", "name": "American Airlines" },
  "worksFor": { "@type": "Organization", "name": "RevFactor", "url": "https://revfactor.io" },
  "description": "Federico Zimerman spent 10 years in airline revenue management at American Airlines before founding Blackbird Hospitality (165+ short-term rental properties across 24 U.S. states and 56 markets) and RevFactor (standalone revenue management service). His strategies deliver +18% RevPAR lift vs. comp set across the portfolio."
};

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": heroImage.startsWith('http') ? heroImage : `https://revfactor.io${heroImage}`,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  "author": federicoPerson,
  "publisher": {
    "@type": "Organization",
    "name": "RevFactor",
    "url": "https://revfactor.io",
    "logo": { "@type": "ImageObject", "url": "https://revfactor.io/og-image.png" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": Astro.url.href },
  "keywords": post.data.tags.join(', '),
  "articleSection": post.data.category,
  "wordCount": post.data.readingTime ? post.data.readingTime * 250 : undefined
};

// FAQPage schema — only when frontmatter declares faqs (drives both accordion + JSON-LD)
const faqSchema = post.data.faqs && post.data.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
} : null;

// BreadcrumbList — site → blog → post
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://revfactor.io" },
    { "@type": "ListItem", "position": 2, "name": "Journal", "item": "https://revfactor.io/blog" },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": Astro.url.href }
  ]
};

// HowTo + DefinedTerm — Blog 1-specific package; only attaches to the pillar post.
const isPillar = post.id === 'revenue-management-for-short-term-rentals';

const howToMinStay = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to use minimum stays as a competitive weapon for short-term rentals",
  "description": "A 4-step playbook for setting minimum stays that beat the survivorship-bias trap most hosts fall into.",
  "totalTime": "PT30M",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Pull average length of stay from your top 5 comp-set listings", "text": "Open each comp-set listing's Reviews tab. Estimate average stay length from review timestamps. Take the median across the 5." },
    { "@type": "HowToStep", "position": 2, "name": "Beat the market minimum by one night", "text": "If the average is at least 1.5 nights below the market minimum, set your minimum 1 night below the market (market 5 → you offer 3 or 4)." },
    { "@type": "HowToStep", "position": 3, "name": "Raise base rates 15–20%", "text": "Capture the visibility premium — you'll appear in searches that competitors are filtered out of. Don't leave the rate flat." },
    { "@type": "HowToStep", "position": 4, "name": "Layer a 10% LOS discount at the market average", "text": "On stays at or above the market average, offer 10% off. Longer-stay guests still see a deal; you still beat the rate of the higher-minimum competitors." }
  ]
};

const howToLaunch = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to launch a new short-term rental listing",
  "description": "The first 30–60 days of a new listing aren't about revenue. They're about reviews, ranking, and algorithm trust.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Set launch price 15–25% below market", "text": "For the first 30–60 days, price aggressively below comparable listings." },
    { "@type": "HowToStep", "position": 2, "name": "Fill the calendar", "text": "Optimize for occupancy, not rate. The algorithm rewards bookings." },
    { "@type": "HowToStep", "position": 3, "name": "Generate reviews fast", "text": "Every booking is a chance for a review. Communicate proactively to maximize review rate." },
    { "@type": "HowToStep", "position": 4, "name": "Transition into revenue mode", "text": "After ~20 strong reviews and stable booking cadence, raise rates back to market and shift focus from occupancy to RevPAR." }
  ]
};

const definedTerms = [
  { "@context": "https://schema.org", "@type": "DefinedTerm", "name": "RevPAR", "description": "Revenue per Available Night. Total revenue divided by total nights available. The only metric that captures rate and occupancy in one number.", "inDefinedTermSet": "https://revfactor.io/glossary" },
  { "@context": "https://schema.org", "@type": "DefinedTerm", "name": "ADR", "description": "Average Daily Rate. The average price of booked nights. Ignores empty nights, which is why it's a misleading standalone metric.", "inDefinedTermSet": "https://revfactor.io/glossary" },
  { "@context": "https://schema.org", "@type": "DefinedTerm", "name": "NetRevPAR", "description": "RevPAR minus variable costs per night (cleaning, channel commissions, OTA fees). Tells you whether the rate-and-occupancy win is making it to your bank account.", "inDefinedTermSet": "https://revfactor.io/glossary" },
  { "@context": "https://schema.org", "@type": "DefinedTerm", "name": "Pacing", "description": "How bookings accumulate week-over-week vs. the same period last year. The single best leading indicator of revenue.", "inDefinedTermSet": "https://revfactor.io/glossary" },
  { "@context": "https://schema.org", "@type": "DefinedTerm", "name": "Length-of-stay discount", "description": "A graduated discount that incentivizes longer bookings without giving away the nightly rate. The discount feels like a deal to the guest; the math is a win for the host.", "inDefinedTermSet": "https://revfactor.io/glossary" },
  { "@context": "https://schema.org", "@type": "DefinedTerm", "name": "Survivorship bias (in STR pricing)", "description": "The minimum-stay rules you can see across your competitors are the ones that survived their pricing decision. The listings that didn't survive — priced out by their own restrictions — are invisible. Setting minimums by copying visible competitors compounds the bias.", "inDefinedTermSet": "https://revfactor.io/glossary" }
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  author={post.data.author}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {isPillar && <script type="application/ld+json" set:html={JSON.stringify(howToMinStay)} />}
    {isPillar && <script type="application/ld+json" set:html={JSON.stringify(howToLaunch)} />}
    {isPillar && definedTerms.map((t) => (
      <script type="application/ld+json" set:html={JSON.stringify(t)} />
    ))}
  </Fragment>

  <Navbar client:load />

  <div id="progressBar" class="fixed top-0 left-0 h-[3px] bg-cedar z-[100] transition-[width] duration-75" style="width:0;"></div>

  <article>
    <!-- IMMERSIVE FULL-BLEED HERO — sized to the image's native ~1.83 wide aspect -->
    <section class="relative overflow-hidden text-[#E8E6E1]" style="height:78vh; min-height:580px; max-height:820px; background-color:#13342D;">
      <!-- Image as <img> (more reliable fill than bg-image), object-cover, parallax-ready.
           scale(1.15) gives parallax headroom so translateY never exposes the section background. -->
      <img
        id="heroBg"
        src={heroImage}
        alt={heroAlt}
        class="absolute inset-0 w-full h-full object-cover will-change-transform"
        style="transform:scale(1.15); transform-origin:center center; z-index:0;"
      />
      <!-- Base darkening wash — uniform light tint so the image carries through, text still legible -->
      <div class="absolute inset-0 z-[1] pointer-events-none" style="background: rgba(22,25,16,0.18);"></div>
      <!-- Top gradient — strong enough for navbar legibility, then fades fast -->
      <div class="absolute top-0 left-0 right-0 h-64 z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(22,25,16,0.85) 0%, rgba(22,25,16,0.5) 40%, rgba(22,25,16,0.15) 80%, rgba(22,25,16,0) 100%);"></div>
      <!-- Bottom gradient — preserves text legibility for the title block, lighter than before -->
      <div class="absolute bottom-0 left-0 right-0 h-[70%] z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(22,25,16,0) 0%, rgba(22,25,16,0.35) 30%, rgba(22,25,16,0.65) 60%, rgba(22,25,16,0.85) 90%, rgba(22,25,16,0.92) 100%);"></div>

      <div class="relative z-[2] max-w-7xl mx-auto px-6 md:px-12 h-full flex flex-col justify-end pb-20 pt-36">
        <span class="font-bold uppercase text-[9px] tracking-[3px] text-[#A9BBA3] mb-6 inline-block">
          {post.data.category} · Field Report
        </span>

        <h1
          class="text-[#E8E6E1] mb-6 max-w-3xl"
          style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:clamp(34px,4.4vw,58px); line-height:1.08; letter-spacing:0.5px; overflow-wrap:break-word; hyphens:auto;"
        >
          {post.data.title}
        </h1>

        <p
          class="mb-10 max-w-3xl"
          style="font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-weight:300; font-size:clamp(20px,2.4vw,30px); color:rgba(221,218,211,0.92); line-height:1.35;"
        >
          {post.data.subhead || post.data.description}
        </p>

        <div class="flex gap-12 flex-wrap pt-7 border-t border-[#DDDAD3]/25" style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(221,218,211,0.7); letter-spacing:0.5px; text-transform:uppercase;">
          <div>
            <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#E8E6E1] mb-1.5" style="font-family:inherit;">Published</div>
            <div>{formattedDate}</div>
          </div>
          {post.data.updatedDate && post.data.updatedDate.toDateString() !== post.data.pubDate.toDateString() && (
            <div>
              <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#E8E6E1] mb-1.5" style="font-family:inherit;">Last Updated</div>
              <div>{post.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
            </div>
          )}
          {post.data.readingTime && (
            <div>
              <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#E8E6E1] mb-1.5" style="font-family:inherit;">Read time</div>
              <div>{post.data.readingTime} minutes</div>
            </div>
          )}
          <div>
            <div class="font-bold uppercase text-[9.5px] tracking-[2px] text-[#E8E6E1] mb-1.5" style="font-family:inherit;">Category</div>
            <div>{post.data.category}</div>
          </div>
          <div class="flex items-center gap-3">
            <img
              src={FEDE_PHOTO}
              alt="Federico Zimerman"
              class="w-10 h-10 rounded-full object-cover ring-1 ring-[#DDDAD3]/30"
            />
            <div>
              <div class="text-[16px] text-[#E8E6E1] lowercase" style="font-family:'Cormorant Garamond',Georgia,serif;">{post.data.author.toLowerCase()}</div>
              <div class="font-bold uppercase text-[9px] tracking-[2px] text-[#DDDAD3]/70">Founder · RevFactor</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Floating TOC — XL+ only. Collapsed pill by default; expands on hover/click into full TOC -->
    <aside id="tocFloat" class="hidden xl:block fixed left-6 top-32 z-30">
      <div id="tocPill" class="rf-toc-pill" tabindex="0" aria-expanded="false" aria-controls="tocPanel" aria-label="Table of contents">
        <span class="rf-toc-progress" aria-hidden="true"><span id="tocProgressFill"></span></span>
        <span class="rf-toc-num tabular-nums" id="tocCurrentNum">01</span>
        <span class="rf-toc-divider">/</span>
        <span class="rf-toc-total tabular-nums">{String(toc.length).padStart(2, '0')}</span>
        <span class="rf-toc-current" id="tocCurrentLabel">{toc[0]?.label}</span>
        <svg class="rf-toc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </div>

      <div id="tocPanel" class="rf-toc-panel" role="region" aria-label="In this essay">
        <p class="rf-toc-panel-kicker">In this essay</p>
        <ol class="rf-toc-panel-list" id="toc">
          {toc.map((item, i) => (
            <li>
              <a href={item.href} class="toc-link" data-toc-idx={i}>
                <span class="rf-toc-panel-num tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <span class="rf-toc-panel-label">{item.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </aside>

    <!-- Mobile/tablet TOC — collapsible, sits above the body so we keep the grid centered -->
    <div class="xl:hidden">
      <details class="rf-mobile-toc max-w-2xl mx-auto px-6 md:px-12 mt-12 pb-2 border-y border-[#C8C4BC]">
        <summary class="flex items-center justify-between gap-4 cursor-pointer py-4 list-none">
          <span class="font-bold uppercase text-[10px] tracking-[2.5px] text-[#76574C]">In this essay · {toc.length} sections</span>
          <svg class="w-3.5 h-3.5 text-[#3F261F] transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <ul class="space-y-2 pb-4">
          {toc.map((item, i) => (
            <li>
              <a href={item.href} class="flex items-baseline gap-2 text-[13px] leading-[1.4] text-[#76574C] hover:text-[#13342D] transition-colors">
                <span class="flex-shrink-0 text-[#3F261F] tabular-nums" style="font-family:'JetBrains Mono',monospace; min-width:22px; opacity:0.7;">{String(i + 1).padStart(2, '0')}</span>
                <span class="block">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>

    <!-- BODY — CSS-grid container with width tiers (body / wide / full-bleed) -->
    <div class="prose-rf pt-10 pb-20 md:pt-12 md:pb-24">
      <Content />
      {post.data.faqs && post.data.faqs.length > 0 && (
        <h2 id="frequently-asked-questions">Frequently Asked Questions</h2>
        <div class="rf-faq">
          {post.data.faqs.map((f) => (
            <details>
              <summary>
                <span class="q">{f.q}</span>
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              </summary>
              <div class="a">{f.a}</div>
            </details>
          ))}
        </div>
      )}
    </div>

    <!-- Tags + Author card — same grid container so they stay centered with body -->
    <div class="prose-rf-after pb-20">
      {post.data.tags.length > 0 && (
        <div class="rf-tags">
          <p class="font-bold uppercase text-[9px] tracking-[2.5px] text-[#8F6E62] mb-3">Topics</p>
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="px-3 py-1 bg-[#E8E6E1] text-[#76574C] text-[12px] rounded-full border border-[#C8C4BC]">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}
      <div class="rf-author-card">
        <img
          src={FEDE_PHOTO}
          alt="Federico Zimerman, Founder of RevFactor"
          class="w-20 h-20 rounded-full object-cover flex-shrink-0 ring-1 ring-[#C8C4BC]"
        />
        <div>
          <h4 class="text-[24px] text-[#3F261F] mb-1" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:500;">{post.data.author.toLowerCase()}</h4>
          <div class="font-bold uppercase text-[9px] tracking-[2px] text-[#8F6E62] mb-4">Founder · RevFactor</div>
          <p class="text-[14px] leading-[1.6] text-[#76574C] mb-3">Federico Zimerman is the founder of <a href="https://revfactor.io" class="underline decoration-[#C8C4BC] underline-offset-2 hover:decoration-cedar hover:text-cedar">RevFactor</a>, a managed revenue management service for short-term rental hosts. He spent 10 years in airline revenue management at American Airlines before applying that yield-management playbook to vacation rentals — strategies that run daily across <strong>165+ STR properties in 24 U.S. states and 56 markets</strong> through Blackbird Hospitality, with a documented <strong>+18% RevPAR lift vs. comp set</strong>.</p>
          <p class="text-[14px] leading-[1.6] text-[#76574C] mb-4">He's been featured on <em>No Vacancy with Natalie Palmer</em> (Ep. 155), <em>Life of Flow</em>, <em>Catchup with the Carlyles</em>, <em>Craft Stays</em>, and <em>STR Like The Best</em>, and posts daily on TikTok (<a href="https://www.tiktok.com/@federicozimerman" target="_blank" rel="noopener" class="underline decoration-[#C8C4BC] underline-offset-2 hover:decoration-cedar hover:text-cedar">@federicozimerman</a>) and Instagram (<a href="https://www.instagram.com/federico.zimerman" target="_blank" rel="noopener" class="underline decoration-[#C8C4BC] underline-offset-2 hover:decoration-cedar hover:text-cedar">@federico.zimerman</a>).</p>
          <div class="flex gap-2 flex-wrap">
            <a href="https://www.linkedin.com/in/federico-zimerman-23ab3345/" target="_blank" rel="noopener" class="px-3 py-1.5 rounded-full border border-[#C8C4BC] text-[11px] font-bold uppercase tracking-[1.5px] text-[#3F261F] hover:border-[#3F261F] transition-colors">Follow on LinkedIn</a>
            <a href="/journal" class="px-3 py-1.5 rounded-full border border-[#C8C4BC] text-[11px] font-bold uppercase tracking-[1.5px] text-[#3F261F] hover:border-[#3F261F] transition-colors">More essays</a>
          </div>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="max-w-7xl mx-auto px-6 md:px-12 pb-24">
        <div class="flex items-end justify-between mb-10 flex-wrap gap-4">
          <div>
            <span class="font-bold uppercase text-[9px] tracking-[3px] text-[#8F6E62] mb-2 block">Keep reading</span>
            <h2 class="text-[#3F261F]" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:clamp(28px,3.5vw,40px);">Read more <em style="font-style:italic; color:#7A8B76;">from the Journal.</em></h2>
          </div>
          <a href="/journal" class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[2px] text-[#3F261F] hover:text-[#13342D] transition-colors">
            All field notes
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {related.map((p) => (
            <a href={p.href} class="group block">
              <div class="relative overflow-hidden rounded-[12px] mb-4" style="aspect-ratio:4/3;">
                <span class="absolute top-3 left-3 z-[2] px-2.5 py-1 rounded-full bg-[#E8E6E1]/92 text-[#3F261F] font-bold uppercase text-[9px] tracking-[2px] backdrop-blur-sm">{p.cat}</span>
                <img src={p.img} alt="" class="w-full h-full object-cover transition-transform duration-[600ms] group-hover:scale-[1.04]"/>
              </div>
              <div class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[1.5px] text-[#8F6E62] mb-2">
                <span>{p.date}</span><span>·</span><span>{p.read}</span>
              </div>
              <h3 class="text-[20px] leading-[1.15] text-[#3F261F] group-hover:text-[#13342D] transition-colors" style="font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;">{p.title}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="max-w-7xl mx-auto px-6 md:px-12 pb-24">
      <div class="p-10 md:p-16 bg-[#13342D] rounded-[24px] text-center">
        <p class="font-bold uppercase text-[9px] tracking-[3px] text-[#7A8B76] mb-4">Ready to optimize your revenue?</p>
