---
import BaseLayout from '../layouts/BaseLayout.astro';
import PPCNavbar from '../components/PPCNavbar.jsx';
import PPCLanding from '../components/PPCLanding.jsx';
import ExitIntent from '../components/ExitIntent.jsx';

const comparisonRows = [
  { label: "Initial portfolio audit", tool: true },
  { label: "Pricing recommendations", tool: true },
  { label: "Ongoing monthly Discovery Call", tool: false },
  { label: "Calendar optimization, not just pricing", tool: false },
  { label: "Comp tracking week-over-week", tool: false },
  { label: "Listing photography + copy review", tool: false },
  { label: "Channel mix strategy (Airbnb vs. VRBO vs. direct)", tool: false },
  { label: "Custom playbook for events + shoulder season", tool: false },
  { label: "You work directly with a seasoned pricing strategist", tool: false },
  { label: "RevFactor dashboard with 24/7 messaging to your strategist", tool: false },
];

const faqs = [
  {
    q: "How is this different from a typical STR consultant?",
    a: "Most consultants run a one-time audit, hand over a deck, and disappear. RevFactor partners ongoing. Monthly Discovery Calls, weekly comp tracking, calendar optimization, listing audits. We're a permanent part of your revenue team.",
  },
  {
    q: "Do you work with hosts who only have 1 property?",
    a: "Yes. Whether you have 1 luxury cabin or 50 properties across multiple markets, the strategy adapts. The fee scales with your portfolio (volume discounts past 5 properties).",
  },
  {
    q: "Who actually does the work?",
    a: "A seasoned pricing strategist on the RevFactor team leads every account directly. No 'senior pitches, junior executes' bait-and-switch. No random handoffs to whoever is free that month.",
  },
  {
    q: "How do I reach my strategist between monthly calls?",
    a: "You get a RevFactor dashboard with 24/7 messaging into the team. Drop a question about a calendar move, a comp shift, or an event opportunity any time. We respond on the same business day.",
  },
  {
    q: "What's the revenue lift?",
    a: "+24% average vs. comp set across our portfolio. Top performers see +20% to +75% year-over-year.",
  },
  {
    q: "How does pricing work?",
    a: "Flat $350/month per property. No percent-of-revenue gotchas. Same price across 1–5 properties; enterprise pricing past 5.",
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.revfactor.io/" },
    { "@type": "ListItem", "position": 2, "name": "Short-Term Rental Consultant", "item": "https://www.revfactor.io/short-term-rental-consultant" },
  ],
};

// FAQPage schema — built from the 6 inline FAQs above.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

// Service schema with AggregateRating + Review — exposes consultant offering
// as a typed service for AI search engines + closes the rich-result eligibility gap.
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Short-Term Rental Consulting Services",
  "serviceType": "Short-Term Rental Revenue Management Consulting",
  "provider": {
    "@type": "Organization",
    "name": "RevFactor",
    "url": "https://www.revfactor.io"
  },
  "areaServed": {
    "@type": "Country",
    "name": "United States"
  },
  "description": "Direct access to a seasoned STR pricing strategist. Monthly strategy partnership, weekly comp tracking, calendar optimization, listing audits. Flat $350/month per property. +24% RevPAR lift documented across 198 listings, 24 states, 67 markets.",
  "offers": {
    "@type": "Offer",
    "price": "350",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "350",
      "priceCurrency": "USD",
      "unitText": "month per property"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "3",
    "bestRating": "5"
  }
};
---

<BaseLayout
  title="Short-Term Rental Consultant | STR Revenue Strategy by RevFactor"
  description="Most STRs lose 24% in revenue. We get it back. Direct access to a seasoned pricing strategist, monthly partnership, 24/7 dashboard messaging. Flat $350/mo per property."
>
  <Fragment slot="head">
    {/* Preload the LCP hero so the browser fetches it immediately, before CSS/JS. */}
    <link
      rel="preload"
      as="image"
      href="/heroes/clifftop-1920.webp"
      imagesrcset="/heroes/clifftop-1200.webp 1200w, /heroes/clifftop-1920.webp 1920w, /heroes/clifftop-2400.webp 2400w"
      imagesizes="100vw"
      fetchpriority="high"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  {/* Capture "Book a Discovery Call" clicks that land before PPCLanding
      hydrates, then re-fire once the modal island is ready. Fixes a silent
      conversion leak where the first click (in the ~2-3s hydration window)
      did nothing. */}
  <script is:inline>
    document.addEventListener('click', function (e) {
      var el = e.target && e.target.closest && e.target.closest('button, a');
      if (!el) return;
      var t = (el.textContent || '').toLowerCase();
      if (t.indexOf('discovery call') === -1 && t.indexOf('strategy call') === -1) return;
      window.__pendingSchedule = true;
      window.dispatchEvent(new CustomEvent('revfactor:open-schedule'));
    }, true);
  </script>

  <PPCNavbar client:load />
  <main>
    <PPCLanding
      client:idle
      heroBase="clifftop"
      heroAlt="Modern clifftop short-term rental at dusk above a cloud sea, RevFactor revenue strategy"
      eyebrow="STR REVENUE STRATEGY"
      headlinePart1="Most STRs lose 24% in revenue."
      headlinePart2Italic="We get it back."
      subhead="A senior STR strategist on every account — monthly strategy, weekly comp tracking, calendar moves, listing audits. +24% portfolio lift documented across 198 listings. Works with whatever pricing tool you use, or none. Free 15-min strategy review. $350 flat per door."
      ctaText="Book a Discovery Call"
      comparisonRows={comparisonRows}
      faqs={faqs}
      finalCtaPretext="READY TO STOP LEAVING REVENUE BEHIND?"
    />
    <ExitIntent client:idle />
  </main>
</BaseLayout>
