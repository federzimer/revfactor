---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.jsx';
import AboutPage from '../components/AboutPage.jsx';

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "RevFactor",
  "url": "https://www.revfactor.io",
  "description": "Short-term rental revenue management across 24 US states and 67 markets.",
  "areaServed": {
    "@type": "Country",
    "name": "United States"
  },
  "numberOfEmployees": {
    "@type": "QuantitativeValue",
    "value": 10
  }
};

// BreadcrumbList: site → about.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.revfactor.io/" },
    { "@type": "ListItem", "position": 2, "name": "About", "item": "https://www.revfactor.io/about/" }
  ]
};
---

<BaseLayout
  title="About RevFactor: STR Revenue Management Across 24 States"
  description="RevFactor is a managed STR revenue management service founded by Federico Zimerman. Dynamic pricing run daily across 198 properties in 24 states and 67 markets, delivering +24% RevPAR vs. comp set."
  ogImageAlt="About RevFactor, a managed short-term rental revenue management service founded by Federico Zimerman, running across 198 properties in 24 states and 67 US markets."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <Navbar client:load />
  <AboutPage client:load />
</BaseLayout>
